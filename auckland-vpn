#!/usr/bin/env bash
#
# auckland-vpn — a reliable wrapper around openconnect for the University of
# Auckland FortiNet SSL VPN.
#
# What this fixes compared to the raw command you were using:
#   * 2FA is generated automatically from a TOTP secret (no phone, no typing
#     a code that just expired).
#   * The VPN password is read from your macOS Keychain (with a protected-file
#     fallback if Keychain can't prompt in your current shell).
#   * --reconnect-timeout keeps the tunnel auto-reconnecting if it drops
#     (this build has no --persistent flag).
#   * Certificate trust uses the system's trusted CAs (the gateway cert is from
#     DigiCert). We deliberately do NOT pin a specific cert, because the
#     university's gateway certificate rotates — pinning would just break later.
#   * The Homebrew vpnc-script (already installed) sets DNS correctly via
#     scutil, which is the usual cause of "connected but nothing resolves".
#
# Usage:
#   see: auckland-vpn help        (canonical; keep all command docs there)

set -euo pipefail

# Private-by-default from the very first file touch: secrets, passwords, logs
# and their directories are created 600/700 with no world-readable window.
umask 077

# ---- Configuration ----------------------------------------------------------
# Your VPN username is NOT hardcoded here (keep it private). Set it via the
# VPN_USER environment variable, or by adding a line  VPN_USER=yourname
# to ~/.config/auckland-vpn/config (that file is yours, not part of this repo).
CONFIG_DIR="$HOME/.config/auckland-vpn"
CONFIG_FILE="$CONFIG_DIR/config"
SECRET_FILE="$CONFIG_DIR/totp-secret"
PASSWORD_FILE="$CONFIG_DIR/vpn-password"
KEYCHAIN_SVC="auckland-vpn"

# Homebrew installs into a different prefix per architecture/setup. Resolve
# ONCE here — before generate_helper bakes the values into the privileged
# helper — so setup-sudo must be re-run only when these actually change.
# The standard prefixes are tried first with cheap [ -x ] tests; spawning
# 'brew --prefix' (~200ms) is a last resort so frequent commands like
# status/log/help never pay for it.
first_executable() {
  local p
  for p in "$@"; do
    if [ -n "$p" ] && [ -x "$p" ]; then
      printf '%s\n' "$p"
      return 0
    fi
  done
  return 1
}

BREW_PREFIX=""
resolve_brew_prefix() {
  [ -n "$BREW_PREFIX" ] || BREW_PREFIX="$(brew --prefix 2>/dev/null || true)"
}
if [ -x /opt/homebrew/bin/openconnect ]; then
  OPENCONNECT_BIN=/opt/homebrew/bin/openconnect
elif [ -x /usr/local/bin/openconnect ]; then
  OPENCONNECT_BIN=/usr/local/bin/openconnect
else
  resolve_brew_prefix
  OPENCONNECT_BIN="$(first_executable \
    "${BREW_PREFIX:+$BREW_PREFIX/bin/openconnect}" \
    "$(command -v openconnect 2>/dev/null || true)")" || OPENCONNECT_BIN=""
fi
if [ -x /opt/homebrew/etc/vpnc/vpnc-script ]; then
  SCRIPT_PATH=/opt/homebrew/etc/vpnc/vpnc-script
elif [ -x /usr/local/etc/vpnc/vpnc-script ]; then
  SCRIPT_PATH=/usr/local/etc/vpnc/vpnc-script
else
  resolve_brew_prefix
  SCRIPT_PATH="$(first_executable \
    "${BREW_PREFIX:+$BREW_PREFIX/etc/vpnc/vpnc-script}")" || SCRIPT_PATH=""
fi
# Empty means "missing": the require_* prereq gates report that with an
# actionable install command instead of failing on a dead hardcoded path.

VPN_HOST="connectvpn.auckland.ac.nz"
VPN_SERVER="connectvpn.auckland.ac.nz/client"   # includes the "client" realm
VPN_PROTO="fortinet"

# Parse the optional config file WITHOUT executing it as shell code (the old
# `. "$CONFIG_FILE"` ran arbitrary content on every invocation). Accepted:
# blank lines, #comments, and 'VPN_USER=<username>' with optional matching
# quotes. Anything else is rejected loudly, naming the file and line.
load_config() {
  [ -f "$CONFIG_FILE" ] || return 0
  local line n=0 value trimmed
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="${line%$'\r'}"
    if [ -z "${line//[[:space:]]/}" ] || [[ "$line" == \#* ]]; then continue; fi
    case "$line" in
      VPN_USER=*) ;;
      *)
        die "$CONFIG_FILE:$n: unsupported line — only blank lines, #comments and VPN_USER=<username> are allowed:
    $line"
        ;;
    esac
    value="${line#VPN_USER=}"
    trimmed="${value#"${value%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    case "$trimmed" in
      \"*\" ) trimmed="${trimmed#\"}"; trimmed="${trimmed%\"}" ;;
      \'*\' ) trimmed="${trimmed#\'}"; trimmed="${trimmed%\'}" ;;
      \"*|*\"|\'*|*\')
        die "$CONFIG_FILE:$n: VPN_USER has unbalanced quotes."
        ;;
    esac
    if [ -z "$trimmed" ]; then
      die "$CONFIG_FILE:$n: VPN_USER has an empty value."
    fi
    if [[ "$trimmed" != *[![:space:]A-Za-z0-9@._-]* ]]; then :; else
      die "$CONFIG_FILE:$n: VPN_USER contains unsupported characters (allowed: letters, digits, @ . _ -)."
    fi
    if [ -n "${VPN_USER:-}" ] && [ "$VPN_USER" != "$trimmed" ]; then
      die "$CONFIG_FILE:$n: duplicate conflicting VPN_USER lines."
    fi
    VPN_USER="$trimmed"
  done <"$CONFIG_FILE"
}

# Private per-user state (mode 700). Holds non-secret diagnostics only
# (keychain-error.txt); the VPN log lives in a root-owned directory (below).
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/auckland-vpn"
# Privileged install targets (see cmd_setup_sudo). Everything under
# HELPER_DIR/LOG_DIR is created and owned by ROOT during setup-sudo:
#   * LOG_DIR is root:wheel 755; LOG_FILE is pre-created owned by YOU
#     (CALLER_UID:CALLER_GID) mode 600. The helper only ever APPENDS via a
#     validated descriptor — root never chowns/recreates the log at runtime.
#   * PID_FILE stays root-owned mode 644 (the PID is not secret; the
#     unprivileged wrapper only ever READS it).
# The generated helper bakes these in at setup-sudo time — after changing
# paths, upgrading this tool, or upgrading openconnect via Homebrew (the
# staged vpnc-script copy is refreshed then too), re-run 'auckland-vpn
# setup-sudo'.
HELPER_DIR="/private/etc/auckland-vpn"
HELPER_BIN="$HELPER_DIR/helper"
STAGED_VPNC_SCRIPT="$HELPER_DIR/vpnc-script"
PID_FILE="$HELPER_DIR/vpn.pid"
LOG_DIR="/private/var/log/auckland-vpn"
LOG_FILE="$LOG_DIR/auckland-vpn.log"
SUDOERS_FILE="/etc/sudoers.d/auckland-vpn"

# Test seams (wrapper-side ONLY; design: docs/consults/test-architecture.md).
# An UNPRIVILEGED test driver may redirect which helper program the wrapper
# asks sudo to run (AUCKLAND_VPN_HELPER_BIN) and which sudo binary performs
# the asking (AUCKLAND_VPN_SUDO_BIN, absolute path). This is safe because the
# installed sudoers rule authorises ONLY the exact installed absolute helper
# with exactly 'start'/'stop': a fake HELPER_BIN is simply rejected by real
# sudo, and a fake SUDO_BIN executes as the current user — power anyone who
# controls this user's environment already has. Neither variable is ever
# granted through sudo (the fragment carries NOSETENV) and NEITHER is ever
# consulted by the generated privileged helper, which bakes all site values
# in at generation time and must contain zero environment switches.
SUDO_BIN="sudo"
if [ "$(/usr/bin/id -u)" -ne 0 ]; then
  if [ -n "${AUCKLAND_VPN_HELPER_BIN:-}" ]; then
    HELPER_BIN="$AUCKLAND_VPN_HELPER_BIN"
  fi
  if [ -n "${AUCKLAND_VPN_SUDO_BIN:-}" ]; then
    SUDO_BIN="$AUCKLAND_VPN_SUDO_BIN"
  fi
fi

# Optional auto-heal monitor (issue #14; design: docs/consults/reliability.md).
# All private per-user state alongside the rest of STATE_DIR.
MONITOR_ENABLED_FILE="$STATE_DIR/monitor.enabled"   # presence == VPN wanted up
MONITOR_STATE_FILE="$STATE_DIR/monitor-state"       # persisted counters
MONITOR_LOCK_DIR="$STATE_DIR/monitor.lock"          # single-monitor lock
MONITOR_LOG="$STATE_DIR/monitor.log"                # transition log

# ---- Helpers ----------------------------------------------------------------
die() { echo "Error: $*" >&2; exit 1; }

# Username gate for commands that NEED it (setup prompts instead; start and
# setup-sudo refuse without it — restart inherits via start).
require_vpn_user() {
  [ -n "$VPN_USER" ] || die "Set your VPN username first: export VPN_USER=yourname  (or run: auckland-vpn setup)"
}

# Distinct, actionable prereq gates — always run BEFORE any sudo interaction,
# so a missing binary is never misreported as a sudo/sudoers problem.
require_openconnect() {
  if [ -z "$OPENCONNECT_BIN" ] || [ ! -x "$OPENCONNECT_BIN" ]; then
    die "openconnect not found — install with: brew install openconnect"
  fi
}
require_vpnc_script() {
  if [ -z "$SCRIPT_PATH" ] || [ ! -x "$SCRIPT_PATH" ]; then
    die "vpnc-script missing — reinstall with: brew install openconnect (it provides etc/vpnc/vpnc-script)"
  fi
}
require_prereqs() {
  require_openconnect
  require_vpnc_script
}

# Fill VPN_USER from the environment or the parsed config file. Runs after
# die() exists so a malformed config can fail loudly. Never executes config
# content as shell code.
VPN_USER="${VPN_USER:-}"
load_config

# True when the installed openconnect supports --pid-file (v8+). The helper
# relies on it so 'stop' can kill an exact recorded PID instead of pkill.
openconnect_supports_pid_file() {
  [ -x "$OPENCONNECT_BIN" ] || return 1
  "$OPENCONNECT_BIN" --help 2>&1 | grep -q -- '--pid-file'
}

# Create the private state directory lazily (only log-writing commands need
# it). Explicit chmod so a directory left by an older version gets tightened
# too; mode 700 keeps the log and its rotation history user-only.
ensure_state_dir() {
  if ! { mkdir -p "$STATE_DIR" && chmod 700 "$STATE_DIR"; }; then
    die "cannot create state dir at $STATE_DIR"
  fi
}

# Prepare ~/.config/auckland-vpn for credential storage: create it mode 700
# and refuse to write secrets into a directory we do not own or that is
# group/world-writable (a tamper risk, not just a privacy one).
ensure_config_dir() {
  # (mkdir -p, then an explicit chmod -m with -p only applies to the leaf.)
  if ! mkdir -p "$CONFIG_DIR" 2>/dev/null; then
    die "cannot create config dir at $CONFIG_DIR"
  fi
  chmod 700 "$CONFIG_DIR" 2>/dev/null || true   # tighten dirs left by older versions
  local owner perms
  owner="$(stat -f '%u' "$CONFIG_DIR" 2>/dev/null)" || die "cannot stat $CONFIG_DIR"
  [ "$owner" = "$(id -u)" ] || die "$CONFIG_DIR is owned by uid $owner, not you — refusing to store credentials there."
  perms="$(stat -f '%Lp' "$CONFIG_DIR" 2>/dev/null)" || die "cannot stat $CONFIG_DIR"
  # Check the GROUP digit (second from the right) and OTHER digit (last) for a
  # write bit (2/3/6/7). Works for 3- and 4-digit modes alike.
  case "${perms: -2:1}${perms: -1}" in
    [2367]*|*[2367])
      die "$CONFIG_DIR is group/world-writable (mode $perms) — refusing to store credentials.
Fix it with: chmod 700 '$CONFIG_DIR'"
      ;;
  esac
}

# Atomic, symlink-safe file write for secrets: never follow a symlink planted
# at the destination; write to a temp file in the SAME directory (same
# filesystem => rename works), chmod 600, then rename over the target.
# Caller must have run ensure_config_dir first. Refuses symlink targets.
write_secret_file() { # write_secret_file <path> <content>
  local target="$1" content="$2" tmp
  if [ -L "$target" ]; then
    die "$target is a symlink — refusing to overwrite it (possible tampering). Remove it and re-run."
  fi
  tmp="$(mktemp "$CONFIG_DIR/.auckland-vpn.XXXXXX")" || die "cannot create temp file in $CONFIG_DIR"
  if ! { printf '%s\n' "$content" >"$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$target"; }; then
    rm -f "$tmp"
    die "could not write $target"
  fi
}

# PID of a live openconnect for OUR host, else nothing. The pidfile is only
# trusted when its recorded process really is openconnect (guards against PID
# reuse); a missing/stale/corrupt/unreadable pidfile falls back to a scoped
# pgrep. Detection only — actual killing goes through the helper (or the
# scoped legacy pkill in cmd_stop), never through this.
running_vpn_pid() {
  local pid pids
  pid="$(cat "$PID_FILE" 2>/dev/null)" || true
  if [[ "$pid" =~ ^[0-9]+$ ]] \
      && ps -p "$pid" -o command= 2>/dev/null | grep -q openconnect; then
    printf '%s\n' "$pid"
    return 0
  fi
  pids="$(pgrep -f "openconnect.*$VPN_HOST" 2>/dev/null)" || true
  printf '%s\n' "${pids%%$'\n'*}"
}

# Last error-looking line of the current log (empty when none or no log).
last_log_error() {
  [ -f "$LOG_FILE" ] || return 0
  local hit
  hit="$(grep -iE 'error|failed|denied|refused|invalid' "$LOG_FILE" 2>/dev/null | tail -n 1)" || true
  [ -n "$hit" ] && printf '%s\n' "$hit"
  return 0
}

# Just the CURRENT attempt's log text (everything after the most recent
# '==== auckland-vpn start' banner). Verification/status must not be fooled
# by connected-markers from a PREVIOUS successful attempt still sitting in
# the append-only log above this run's banner.
attempt_log() {
  awk '/^==== auckland-vpn start/{buf=""; seen=1} seen {buf = buf $0 "\n"} END{printf "%s", buf}' "$LOG_FILE" 2>/dev/null
}

# Best-effort tunnel IPv4 from THIS attempt's log: prefer openconnect's
# "Connected as A.B.C.D" line, else an inet address logged next to a utun
# interface. Empty output when neither appears. (grep -o, not gawk match():
# macOS ships BSD awk without the 3-argument match().)
tunnel_ip_from_log() {
  local ip attempt
  attempt="$(attempt_log)" || true
  [ -n "$attempt" ] || return 0
  ip="$(grep -iEo 'connected as ([0-9]{1,3}\.){3}[0-9]{1,3}' <<<"$attempt" \
        | head -n 1 | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}')" || true
  if [ -z "$ip" ]; then
    ip="$(grep -A2 -i 'utun' <<<"$attempt" \
          | grep -Eo 'inet ([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n 1 \
          | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}')" || true
  fi
  [ -n "$ip" ] && printf '%s\n' "$ip"
  return 0
}

# The helper exiting 0 only proves launch began. Poll briefly (bounded ~15s)
# for hard evidence — recorded pidfile plus a STRONG connected marker
# ('Connected as <ip>' or 'Established DTLS/TLS') in THIS attempt's log only
# (a bare word like 'tunnel' proves nothing) — printing progress so the pause
# doesn't feel hung.
verify_tunnel_started() {
  local waited=0
  printf 'verifying'
  while [ "$waited" -lt 30 ]; do
    if [ -s "$PID_FILE" ] \
        && attempt_log | grep -qiE 'connected as|established (dtls|tls)'; then
      printf '\n'
      return 0
    fi
    sleep 0.5
    waited=$((waited + 1))
    printf ' .'
  done
  printf '\n'
  return 1
}

# Distinct, actionable failure report: show the log tail inline and point at
# the full log — but never dress a log-write problem up as "Connection failed".
report_start_failure() {
  if [ -s "$LOG_FILE" ]; then
    echo "--- last 15 log lines ($LOG_FILE) ---"
    tail -n 15 "$LOG_FILE" 2>/dev/null || true
    echo "Connection failed. Full log: auckland-vpn log"
  else
    echo "Connection failed — nothing was written to $LOG_FILE (re-run: auckland-vpn setup-sudo)."
  fi
  echo "(If sudo refused permission instead, re-run: auckland-vpn setup-sudo)"
  exit 1
}

# Refuse to stack a second tunnel on top of a healthy one: two openconnects
# fight over utun/DNS/routes. Use 'restart' to replace a running tunnel.
refuse_if_already_running() {
  local pid
  pid="$(running_vpn_pid || true)"
  if [ -n "$pid" ]; then
    die "already connected/starting (pid $pid); use: auckland-vpn restart"
  fi
}

# After stop, wait out the old process before starting anew: SIGTERM delivery
# is not process death, and launching beside a dying tunnel means two clients
# fighting over utun/DNS/routes. Best-effort only: ~10s poll, then a single
# helper stop whose output is discarded here. The helper deliberately never
# escalates to SIGKILL (recycled-PID hazard); it reports a survivor on its own
# stop command, so callers that must not race one re-check (cmd_start's
# already-running guard).
wait_until_vpn_gone() {
  local waited=0 pid
  while :; do
    pid="$(running_vpn_pid || true)"
    [ -z "$pid" ] && return 0
    [ "$waited" -ge 20 ] && break
    sleep 0.5
    waited=$((waited + 1))
  done
  if [ -x "$HELPER_BIN" ]; then
    "$SUDO_BIN" -n "$HELPER_BIN" stop >/dev/null 2>&1 || true
  fi
}

# Emit the privileged helper script with all site values baked in at
# generation time. Installed root-owned at $HELPER_BIN by 'setup-sudo';
# sudoers allows ONLY '<helper> start' / '<helper> stop'. Regenerate by
# editing this function and re-running setup-sudo.
generate_helper() {
  local pid_support=0
  openconnect_supports_pid_file && pid_support=1
  printf '%s\n' '#!/bin/bash -p'
  printf '%s\n' '# auckland-vpn privileged helper — GENERATED by "auckland-vpn setup-sudo".'
  printf '%s\n' '# Installed root-owned; the sudoers rule allows exactly:'
  printf '%s\n' "#   $HELPER_BIN start"
  printf '%s\n' "#   $HELPER_BIN stop"
  printf '%s\n' '# All site values below are fixed at generation time. To change them,'
  printf '%s\n' '# edit the generator in the auckland-vpn script and re-run setup-sudo.'
  printf '%s\n' '#'
  printf '%s\n' '# Privileged environment hardening (P0):'
  printf '%s\n' '#   * "#!/bin/bash -p" starts bash in privileged mode before any startup'
  printf '%s\n' '#     file could be processed; BASH_ENV/ENV are unset below regardless.'
  printf '%s\n' '#   * The environment is reset to a fixed minimal set and every utility is'
  printf '%s\n' '#     invoked by absolute path — nothing depends on inherited PATH.'
  printf '%s\n' '#   * openconnect itself launches through "env -i" with an explicit minimal'
  printf '%s\n' '#     environment, so nothing from the invoking user leaks into it.'
  printf '%s\n' '#   * The sudoers fragment carries NOSETENV (sudo never honours SETENV or a'
  printf '%s\n' '#     user-provided environment for these commands) plus a command-scoped'
  printf '%s\n' '#     secure_path as defence in depth. The helper also pins the invoking'
  printf '%s\n' '#     identity: SUDO_UID/SUDO_GID must equal the baked CALLER_UID/GID.'
  printf '%s\n' '#'
  printf '%s\n' '# Residual risk (accepted): openconnect and its libraries live in the'
  printf '%s\n' '# user-writable Homebrew prefix. The tamper check below blocks OTHER'
  printf '%s\n' '# local users and world/staff-writable paths; it cannot stop the account'
  printf '%s\n' '# owner or another admin from swapping the binary — they already hold'
  printf '%s\n' '# full sudo via the admin group, so nothing is granted that was not'
  printf '%s\n' '# already theirs.'
  printf '%s\n' '#'
  printf '%s\n' '# Root-side writes happen ONLY under HELPER_DIR and LOG_DIR (both root-'
  printf '%s\n' '# owned directories installed by setup-sudo): the log is pre-created'
  printf '%s\n' '# owned by CALLER_UID:CALLER_GID mode 600 and appended via fd 3 — never'
  printf '%s\n' '# chowned/recreated at runtime; the pidfile is PRE-CREATED root-owned'
  printf '%s\n' '# 644 by setup-sudo and KEPT across stops (openconnect truncates an'
  printf '%s\n' '# existing --pid-file; readers tolerate it empty/stale); the TOTP token'
  printf '%s\n' '# file is a root-owned mktemp (mode 600 via umask) removed by the EXIT'
  printf '%s\n' '# trap. The helper opens no user-owned path: credentials arrive on'
  printf '%s\n' '# stdin as two records.'
  # Baked values (%q makes each safe as a literal shell assignment).
  printf 'OC=%q\n' "$OPENCONNECT_BIN"
  printf 'VPNC_SCRIPT=%q\n' "$STAGED_VPNC_SCRIPT"
  printf 'PROTO=%q\n' "$VPN_PROTO"
  printf 'SERVER=%q\n' "$VPN_SERVER"
  printf 'VPN_USER=%q\n' "$VPN_USER"
  printf 'LOG_FILE=%q\n' "$LOG_FILE"
  printf 'PID_FILE=%q\n' "$PID_FILE"
  printf 'OP_LOCK=%q\n' "$HELPER_DIR/operation.lock"
  printf 'TOKEN_DIR=%q\n' "$HELPER_DIR"
  printf 'CALLER_UID=%q\n' "$(/usr/bin/id -u)"
  printf 'CALLER_GID=%q\n' "$(/usr/bin/id -g)"
  printf 'OC_HAS_PID_FILE=%q\n' "$pid_support"
  cat <<'BODY'
set -euo pipefail

# Fixed minimal privileged environment: no inherited variable survives.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
HOME=/var/root
USER=root
LOGNAME=root
LANG=C
unset BASH_ENV ENV CDPATH GLOBIGNORE

umask 077

TOKEN_FILE=""
LOCK_HELD=""

# Remove our temp token file and our operation lock. Runs ONLY via the EXIT
# trap: signals map to conventional exit codes (see traps below) whose EXIT
# handling still releases the lock/token. Trapping cleanup directly on
# HUP/INT/TERM made the handler RETURN and RESUME a half-torn-down
# privileged run. The lock dir carries our PID so we only ever remove a
# lock we acquired ourselves; marker-file + rmdir (never rm -rf) so any
# unexpected extra contents become a loud failure, not swallowed debris.
cleanup() {
  if [ -n "$TOKEN_FILE" ]; then /bin/rm -f "$TOKEN_FILE"; fi
  if [ -n "$LOCK_HELD" ] \
      && [ "$(/bin/cat "$OP_LOCK/pid" 2>/dev/null || true)" = "$$" ]; then
    /bin/rm -f "$OP_LOCK/pid"
    /bin/rmdir "$OP_LOCK" 2>/dev/null || true
  fi
  return 0
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

die() { echo "auckland-vpn helper: error: $*" >&2; exit 1; }

usage() {
  echo "usage: $(/usr/bin/basename "$0") start|stop" >&2
  exit 2
}

# Atomic root-side operation lock: only ONE start OR stop runs at a time.
# /bin/mkdir is atomic. A leftover dir is stale debris from a killed helper —
# but only ever removed PROVABLY so: an empty/unreadable marker may belong to
# a starter still inside its mkdir→write-pid window, so deleting it on sight
# would steal a LIVE lock; we retry ~10 × 0.2s expecting the owner to record
# its PID. Removal happens (a) when the marker names a holder ps cannot find,
# or (b) after that grace window with the marker STILL empty — and then by
# clearing the marker file and rmdir(2), never rm -rf, so a directory that
# grew unexpected contents fails loudly instead of being swallowed. Every
# decision is logged to stderr.
acquire_lock() {
  local holder tries=0
  until /bin/mkdir "$OP_LOCK" 2>/dev/null; do
    tries=$((tries + 1))
    [ "$tries" -le 40 ] || die "cannot acquire operation lock at $OP_LOCK (stale or corrupt). Remove it manually as root:  sudo /bin/rmdir '$OP_LOCK'"
    holder="$(/bin/cat "$OP_LOCK/pid" 2>/dev/null || true)"
    case "$holder" in
      ''|*[!0-9]*)
        if [ "$tries" -le 10 ]; then
          echo "auckland-vpn helper: lock marker at $OP_LOCK is empty (attempt $tries/10) — waiting for its owner to record its PID." >&2
          /bin/sleep 0.2
          continue
        fi
        echo "auckland-vpn helper: lock marker still empty after grace — treating the lock as abandoned and taking over." >&2
        ;;
      *)
        if kill -0 "$holder" 2>/dev/null; then
          die "another start/stop operation is in progress (pid $holder); try again shortly."
        fi
        echo "auckland-vpn helper: recorded lock holder (pid $holder) is dead — taking over the stale lock." >&2
        ;;
    esac
    # Only a proven-dead holder or an empty-after-grace marker reaches this.
    # rm the single known marker file, then rmdir: if anything unexpected
    # appeared inside, rmdir refuses and the bound above ends in the loud,
    # actionable die() instead of a recursive delete.
    /bin/rm -f "$OP_LOCK/pid"
    /bin/rmdir "$OP_LOCK" 2>/dev/null || true
  done
  printf '%s\n' "$$" >"$OP_LOCK/pid"
  LOCK_HELD=1
}

# Tamper check for the trusted path: every component from the path itself up
# to / must exist, be owned by root or the invoking user (CALLER_UID), carry
# no WORLD-writable bit, and allow group-write only for the 'admin' group
# (gid 80 — stock Homebrew ships admin-writable dirs, and admin members
# already hold full sudo, so that grants them nothing new). A staff/group-
# writable or world-writable ancestor would hand root code execution to
# arbitrary local users via the privileged helper.
path_is_trusted() {
  local p="$1" perms t hops=0
  while :; do
    [ -e "$p" ] || return 1
    local u g; u="$(/usr/bin/stat -f '%u' "$p")"; g="$(/usr/bin/stat -f '%g' "$p")"
    [ "$u" = "$CALLER_UID" ] || [ "$u" = "0" ] || return 1
    perms="$(/usr/bin/stat -f '%Sp' "$p")"     # e.g. "-rwxr-xr-x"
    case "$perms" in
      ????????w*) return 1 ;;                  # other-write set: any user can tamper
      ?????w*)
        [ "$g" = "80" ] || return 1 ;;         # group-write outside 'admin'
    esac
    if [ -L "$p" ]; then                       # keep checking via the link target
      hops=$((hops + 1))
      [ "$hops" -gt 16 ] && return 1           # symlink loop / absurd chain
      t="$(/usr/bin/readlink "$p")"
      case "$t" in
        /*) p="$t" ;;
        *)  p="$(/usr/bin/dirname "$p")/$t" ;;
      esac
      continue
    fi
    [ "$p" != "/" ] || return 0
    p="$(/usr/bin/dirname "$p")"
  done
}

# Shared pidfile gate used by BOTH helper start and stop: it must exist, be
# a regular non-symlink file, and be owned by root — or by the pinned
# invoking user (CALLER_UID), which keeps this validator exercisable in
# unprivileged sandboxes; production keeps the file root-owned inside the
# root-owned HELPER_DIR, so no third party can plant one either way.
# Anything else is refused loudly and never touched blindly by root.
validate_pid_file() {
  local owner
  if [ ! -e "$PID_FILE" ] && [ ! -L "$PID_FILE" ]; then
    die "no pidfile at $PID_FILE (setup-sudo pre-creates it) — was the VPN started by the helper?"
  fi
  if [ -L "$PID_FILE" ] || [ ! -f "$PID_FILE" ]; then
    die "$PID_FILE exists but is not a regular root-owned file; remove it manually as root, then retry."
  fi
  owner="$(/usr/bin/stat -f '%u' "$PID_FILE")" || die "cannot read the owner of $PID_FILE"
  if [ "$owner" != "0" ] && [ "$owner" != "$CALLER_UID" ]; then
    die "$PID_FILE is owned by uid $owner, not root; remove it manually as root, then retry."
  fi
}

cmd_start() {
  acquire_lock

  # Refuse to run anything as root unless the exact generated paths are intact.
  path_is_trusted "$OC"          || die "$OC is missing or not root-trusted; refusing to start."
  path_is_trusted "$VPNC_SCRIPT" || die "$VPNC_SCRIPT is missing or not root-trusted; refusing to start."
  [ "$OC_HAS_PID_FILE" = "1" ] || die "$OC lacks --pid-file support; re-run: auckland-vpn setup-sudo"

  # The log was pre-created by setup-sudo inside the ROOT-owned LOG_DIR,
  # owned by the invoking user, mode 600 — so the user cannot swap it and we
  # never chown/recreate it here. Open ONCE; every write this run goes
  # through fd 3 (banner + openconnect output). Missing file => old install.
  if [ ! -f "$LOG_FILE" ] || [ -L "$LOG_FILE" ]; then
    die "log missing or not a regular file at $LOG_FILE; re-run: auckland-vpn setup-sudo"
  fi
  exec 3>>"$LOG_FILE"

  # The pidfile is PRE-CREATED root-owned mode 644 by setup-sudo and KEPT
  # across stops: openconnect truncates an existing --pid-file, and the
  # unprivileged wrapper only ever READS it (empty/stale records between
  # runs are normal; readers fall back gracefully). Root never chowns or
  # chmods it at runtime — the installer fixed owner and mode. A symlink or
  # foreign-owned file is refused above, never touched.
  validate_pid_file
  # Truncate so the wait below can only observe THIS attempt's pid: a
  # leftover record from a previous run must not read as fresh success.
  : >"$PID_FILE"

  # Credentials arrive on stdin as TWO newline-terminated records: VPN
  # password, then TOTP secret. Newline framing is safe because 'setup'
  # strips ALL whitespace from stored secrets, the wrapper strips the TOTP
  # secret again, and the wrapper REJECTS any stored password containing a
  # newline before piping anything. Root reads NO user-owned path — the
  # wrapper reads the secret itself.
  local pass="" token=""
  IFS= read -r pass || true
  [ -n "$pass" ] || die "no VPN password received on stdin"
  IFS= read -r token || true
  [ -n "$token" ] || die "no TOTP secret received on stdin"

  # --token-secret=@file needs a real path: park the secret in a root-owned
  # mktemp INSIDE HELPER_DIR, removed by the cleanup trap (openconnect
  # unlinks @files after reading; the trap covers failures). umask 077 plus
  # mktemp already yield mode 600 — no runtime chmod needed.
  TOKEN_FILE="$(/usr/bin/mktemp "$TOKEN_DIR/token.XXXXXX")" \
    || die "cannot create token temp file in $TOKEN_DIR"
  printf '%s\n' "$token" >"$TOKEN_FILE"

  # Append the dated banner via the open fd. The log is append-only with
  # per-attempt banners ('attempt_log' scopes by banner); there is no .prev
  # rotation — recreating/renaming the log would force runtime chowns.
  printf '==== auckland-vpn start %s ====\n' "$(/bin/date '+%Y-%m-%d %H:%M:%S')" >&3 \
    || die "cannot write log at $LOG_FILE"

  # Fixed arguments only — nothing here comes from the invoking user.
  # openconnect backgrounds itself after connecting (--background) and writes
  # the daemon PID to $PID_FILE (--pid-file), which 'stop' uses instead of
  # pattern-killing processes. umask 022 so a freshly created pidfile would
  # be world-readable (setup-sudo normally pre-creates it mode 644; this
  # covers a first creation too). Launched via env -i: explicit env only.
  # --non-inter (audit P1): if the server rejects the software token or
  # presents an unsupported auth form, FAIL instead of waiting on stdin this
  # root, background process can never supply.
  umask 022
  if ! printf '%s\n' "$pass" | /usr/bin/env -i \
      PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=/var/root USER=root LOGNAME=root LANG=C \
      "$OC" \
      --protocol="$PROTO" \
      --user="$VPN_USER" \
      --passwd-on-stdin \
      --non-inter \
      --token-mode=totp \
      --token-secret="@$TOKEN_FILE" \
      --reconnect-timeout=300 \
      --background \
      --pid-file="$PID_FILE" \
      --script="$VPNC_SCRIPT" \
      "$SERVER" >&3 2>&1; then
    die "openconnect failed to launch; see $LOG_FILE"
  fi

  # The daemon writes the pidfile once connected; give it up to ~30 seconds.
  local waited=0
  while [ ! -s "$PID_FILE" ]; do
    [ "$waited" -ge 60 ] && die "no PID reported after 30s; see $LOG_FILE"
    /bin/sleep 0.5
    waited=$((waited + 1))
  done
  # PID not secret; the unprivileged wrapper reads it for status/guards.
  # Owner and mode were fixed at install time (root:wheel 644) and openconnect
  # only truncates/writes the existing file — nothing to normalize here, and
  # root never chowns/chmods at runtime.
  echo "VPN started (pid $(/bin/cat "$PID_FILE")). Log: $LOG_FILE"
}

cmd_stop() {
  acquire_lock
  validate_pid_file
  local pid lstart now waited=0 cmdline
  pid="$(/bin/cat "$PID_FILE")"
  case "$pid" in
    '')
      # The pidfile persists across stops; an empty record just means no VPN
      # is running (e.g. after a failed start). Nothing to do — no sudo-side
      # drama, nothing removed.
      echo "No VPN is recorded as running (pidfile is empty); nothing to stop."
      return 0
      ;;
    *[!0-9]*) die "corrupt pidfile $PID_FILE" ;;
  esac

  # Kill the recorded PID only if it still belongs to OUR openconnect
  # (guards against PID reuse). Never pattern-kill other processes. A record
  # naming anything else is a stale leftover from a finished run: say so and
  # stop cleanly — the pidfile is kept, the next start truncates it.
  cmdline="$(/bin/ps -p "$pid" -o command= 2>/dev/null || true)"
  if [[ "$cmdline" != *openconnect* || "$cmdline" != *"$SERVER"* ]]; then
    echo "Not connected (recorded pid $pid is no longer our openconnect)."
    return 0
  fi
  # Pin the process identity across the WHOLE wait with its start time:
  # if the PID vanishes (reaped) or is REUSED mid-wait (lstart changes),
  # break WITHOUT escalating — SIGKILL must never land on a recycled PID.
  lstart="$(/bin/ps -p "$pid" -o lstart= 2>/dev/null || true)"

  kill "$pid"
  while :; do
    now="$(/bin/ps -p "$pid" -o lstart= 2>/dev/null || true)"
    if [ -z "$now" ] || [ "$now" != "$lstart" ]; then
      break                                    # gone, or reused: stop waiting
    fi
    if [ "$waited" -ge 20 ]; then              # ~10s
      # No SIGKILL escalation: on a recycled PID it would kill an innocent
      # process. Report honestly, remove nothing, fail loudly.
      echo "Warning: openconnect (pid $pid) did not exit within ~10s of SIGTERM." >&2
      echo "It was deliberately NOT force-killed (SIGKILL could land on a recycled PID)." >&2
      echo "Inspect it manually:  /bin/ps -p $pid -o lstart=,command=" >&2
      echo "If the machine has rebooted since, or the process is really gone," >&2
      echo "this stale record is harmless — the next start reuses the pidfile." >&2
      exit 1
    fi
    /bin/sleep 0.5
    waited=$((waited + 1))
  done
  # The pidfile is persistent infrastructure (root-owned 644): keep it with
  # its now-dead PID. Readers tolerate stale records; the next start
  # truncates it before launching a fresh daemon.
  echo "Disconnected."
}

main() {
  [ $# -eq 1 ] || usage
  # Pin the invoking identity: sudo always exports SUDO_UID/SUDO_GID, and
  # they must match what was baked in at generation time (a sudoers rule
  # copied to another account must not drive this helper).
  if [ "${SUDO_UID:-}" != "$CALLER_UID" ] || [ "${SUDO_GID:-}" != "$CALLER_GID" ]; then
    die "invoking uid/gid (${SUDO_UID:-unset}:${SUDO_GID:-unset}) does not match the installed caller ($CALLER_UID:$CALLER_GID); re-run: auckland-vpn setup-sudo"
  fi
  case "$1" in
    start) cmd_start ;;
    stop)  cmd_stop ;;
    *)     usage ;;
  esac
}

# Direct execution dispatches; being sourced (tests) only defines functions.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
BODY
}

# Report old broad sudoers grants (NOPASSWD on raw openconnect / pkill).
# Scans the given files, or /etc/sudoers + /etc/sudoers.d/* by default.
# Returns 1 when something was found (so callers can react). Note: a stock
# /etc/sudoers is only readable by root; setup-sudo repeats this scan
# privileged and reports anything it finds.
detect_legacy_rule() {
  local scan hits f
  if [ "$#" -gt 0 ]; then
    scan=("$@")
  else
    scan=(/etc/sudoers /etc/sudoers.d/*)
  fi
  hits="$(grep -Hn 'openconnect\|pkill' "${scan[@]}" 2>/dev/null | grep NOPASSWD || true)"
  [ -n "$hits" ] || return 0
  echo "WARNING: old broad sudoers rule(s) grant passwordless root:" >&2
  while IFS= read -r line; do echo "    $line" >&2; done <<<"$hits"
  echo "$hits" | cut -d: -f1 | sort -u | while read -r f; do
    if [ "$f" = "/etc/sudoers" ]; then
      echo "  Remove with: sudo visudo   (delete the offending line in $f)" >&2
    else
      echo "  Remove with: sudo rm '$f'" >&2
    fi
  done
  return 1
}

# The canonical explanation shown wherever passwordless setup is missing.
# Note: 'start' needs the helper installed by setup-sudo; without it, start
# refuses here with these instructions.
print_sudoers_hint() {
  echo "Passwordless start is not installed. Run once:"
  echo "  auckland-vpn setup-sudo"
  echo "That installs a root-owned helper ($HELPER_BIN) and a sudoers rule"
  echo "allowing ONLY 'helper start' / 'helper stop' — never raw openconnect"
  echo "(granting the raw binary allowed arbitrary root code execution via"
  echo "--script=, and the old pkill grant could kill any root process)."
  echo "Until then, 'auckland-vpn start' refuses — the privileged helper is what"
  echo "launches the tunnel; run 'auckland-vpn setup-sudo' to install it."
  detect_legacy_rule /etc/sudoers /etc/sudoers.d/* \
    || echo "Fix the warning(s) above so they cannot undermine the new rule." >&2
  return 0
}

# Emit the STATIC privileged installer. NOTHING is interpolated into the
# emitted text: every site value arrives as a positional parameter, so
# apostrophes or spaces in any path can no longer silently break an
# installed command. Layout:
#   $1 caller UID   $2 caller GID
#   $3 HELPER_DIR   $4 LOG_DIR    $5 LOG_FILE
#   $6 vpnc-script source   $7 staged vpnc-script destination
#   $8 PID_FILE     $9 HELPER_BIN ${10} SUDOERS_FILE
#   ${11} helper source     ${12} sudoers fragment source
generate_installer() {
  cat <<'INSTALLER'
#!/bin/sh
set -eu
# Privileged install step for auckland-vpn, run as:
#   sudo sh install.sh <12 positional parameters, see generator>
# All site values arrive as arguments; uid/gid are re-validated numerically
# before any use.
CALLER_UID="$1"; CALLER_GID="$2"
HELPER_DIR="$3"; LOG_DIR="$4"; LOG_FILE="$5"
VPNC_SRC="$6";  VPNC_DST="$7"
PID_FILE="$8";  HELPER_BIN="$9"; SUDOERS_FILE="${10}"
HELPER_SRC="${11}"; SUDOERS_SRC="${12}"

case "$CALLER_UID$CALLER_GID" in
  ''|*[!0-9]*) echo "install.sh: caller uid/gid must be numeric" >&2; exit 1 ;;
esac

# Root-owned directories first; everything below lands inside them.
install -d -o root -g wheel -m 755 "$HELPER_DIR"
install -d -o root -g wheel -m 755 "$LOG_DIR"

# Log: pre-created owned by the invoking user mode 600 inside the ROOT-owned
# log dir; re-running heals owner/mode of an existing log. The helper only
# ever appends to it — never chowns or recreates it at runtime.
if [ ! -f "$LOG_FILE" ] || [ -L "$LOG_FILE" ]; then
  rm -f "$LOG_FILE"
  install -m 600 -o "$CALLER_UID" -g "$CALLER_GID" /dev/null "$LOG_FILE"
fi
chown "$CALLER_UID:$CALLER_GID" "$LOG_FILE"
chmod 600 "$LOG_FILE"

# Stage the vpnc-script copy the helper will actually run.
install -o root -g wheel -m 755 "$VPNC_SRC" "$VPNC_DST"

# Pidfile: PRE-CREATED root-owned mode 644 and KEPT across stops — openconnect
# truncates an existing --pid-file, and the unprivileged wrapper only reads
# it. Heal a planted symlink/non-regular file first; install() then fixes
# owner/mode no matter what regular file was there before.
if [ -L "$PID_FILE" ] || { [ -e "$PID_FILE" ] && [ ! -f "$PID_FILE" ]; }; then
  rm -f "$PID_FILE"
fi
install -o root -g wheel -m 644 /dev/null "$PID_FILE"
rm -f "$HELPER_DIR/vpn.pid.prev"

install -o root -g wheel -m 755 "$HELPER_SRC" "$HELPER_BIN"

rm -f "$SUDOERS_FILE"
install -o root -g wheel -m 440 "$SUDOERS_SRC" "$SUDOERS_FILE"

echo '--- legacy-rule scan (reporting only; nothing auto-removed from /etc/sudoers) ---'
grep -Hn 'openconnect\|pkill' /etc/sudoers /etc/sudoers.d/* 2>/dev/null | grep NOPASSWD || true
INSTALLER
}

# Canonical privileged setup: generates helper + sudoers fragment into a temp
# dir, validates the sudoers syntax with visudo -cf, then installs BOTH in a
# single sudo interaction. Never appends to /etc/sudoers.
cmd_setup_sudo() {
  [ "$(/usr/bin/id -u)" -ne 0 ] || die "run this as your normal user; it will ask for your Mac password once."
  # Prereqs and username BEFORE anything else: the generated helper bakes the
  # resolved binary paths and VPN_USER in at this moment, and no sudo prompt
  # should happen while something as basic as openconnect is still missing.
  require_prereqs
  require_vpn_user
  openconnect_supports_pid_file \
    || die "$OPENCONNECT_BIN lacks --pid-file (needed for safe stop). Run: brew upgrade openconnect"

  # Resolve uid/gid ONCE, by absolute path, and validate them BEFORE they are
  # used anywhere (they are passed as installer arguments and baked into the
  # generated helper).
  local caller_uid caller_gid
  caller_uid="$(/usr/bin/id -u)" || die "cannot determine your uid."
  caller_gid="$(/usr/bin/id -g)" || die "cannot determine your gid."
  case "$caller_uid" in ''|*[!0-9]*) die "unexpected uid: $caller_uid" ;; esac
  case "$caller_gid" in ''|*[!0-9]*) die "unexpected gid: $caller_gid" ;; esac

  # Stage in the PRIVATE state dir, never /tmp: setup-sudo must not create
  # files (even transient ones) in a world-writable, shared directory.
  ensure_state_dir
  local tmp
  tmp="$(mktemp -d "$STATE_DIR/setup.XXXXXX")" || die "cannot create staging dir in $STATE_DIR"
  trap 'rm -rf "$tmp"' EXIT
  generate_helper >"$tmp/helper"
  chmod 755 "$tmp/helper"
  # NOSETENV: sudo will never honour SETENV or a user-supplied environment
  # for these commands. secure_path is command-scoped defence in depth (the
  # helper also hardcodes PATH). Validated below before anything installs.
  printf '%s ALL=(root) NOPASSWD:NOSETENV: %s start, %s stop\n' \
    "$(whoami)" "$HELPER_BIN" "$HELPER_BIN" >"$tmp/auckland-vpn"
  printf 'Defaults!%s secure_path="/usr/bin:/bin:/usr/sbin:/sbin"\n' \
    "$HELPER_BIN" >>"$tmp/auckland-vpn"
  visudo -cf "$tmp/auckland-vpn" >/dev/null \
    || die "generated sudoers rule failed 'visudo -cf'; nothing was installed."

  # Static installer body + all values as positional parameters: nothing is
  # interpolated into the emitted script, so apostrophes/spaces in any path
  # are harmless (the old inline-quoted lines broke silently on them).
  generate_installer >"$tmp/install.sh"

  echo "Installing root-owned helper + restricted sudoers rule (one sudo prompt)..."
  "$SUDO_BIN" sh "$tmp/install.sh" \
    "$caller_uid" "$caller_gid" \
    "$HELPER_DIR" "$LOG_DIR" "$LOG_FILE" \
    "$SCRIPT_PATH" "$STAGED_VPNC_SCRIPT" \
    "$PID_FILE" "$HELPER_BIN" "$SUDOERS_FILE" \
    "$tmp/helper" "$tmp/auckland-vpn" \
    || die "privileged install failed."
  trap - EXIT
  rm -rf "$tmp"
  echo "Done. Passwordless sudo is now limited to exactly:"
  echo "  sudo -n $HELPER_BIN start"
  echo "  sudo -n $HELPER_BIN stop"
  echo "Staged vpnc-script: $STAGED_VPNC_SCRIPT (used by the helper)."
  echo "Log file: $LOG_FILE (owned by you, mode 600, inside a root-owned dir)."
  echo "Re-run 'auckland-vpn setup-sudo' after upgrading this tool OR after"
  echo "'brew upgrade openconnect': the helper embeds paths/settings at"
  echo "generation time, including the staged vpnc-script copy."
  echo "If any legacy-rule lines were printed above, remove them:"
  echo "  sudo visudo (for /etc/sudoers) or: sudo rm /etc/sudoers.d/<offending-file>"
}

# Truthful status: distinguish connected (live process + connected evidence
# in this attempt's log), still connecting, and not connected — with the last
# error line from the log when the previous attempt failed.
cmd_status() {
  local pid ip last_err
  pid="$(running_vpn_pid || true)"
  if [ -z "$pid" ]; then
    echo "Not connected."
    last_err="$(last_log_error || true)"
    if [ -n "$last_err" ]; then
      echo "Last attempt failed: $last_err"
    fi
    return 0
  fi
  if attempt_log | grep -qiE 'connected as|established (dtls|tls)'; then
    ip="$(tunnel_ip_from_log || true)"
    if [ -n "$ip" ]; then
      echo "Connected as $VPN_USER (pid $pid, IP $ip)."
    else
      echo "Connected as $VPN_USER (pid $pid)."
    fi
  else
    echo "Connecting... (pid $pid)"
  fi
}

# Default: print the last 50 lines and exit. 'log -f' (or 'log follow')
# streams new output until Ctrl-C.
cmd_log() {
  if [ ! -f "$LOG_FILE" ]; then
    echo "No log file yet ($LOG_FILE). Run 'auckland-vpn start' first."
    return 1
  fi
  case "${1:-}" in
    -f|--follow|follow)
      echo "(Ctrl-C to stop following)"
      tail -n 50 -f "$LOG_FILE"
      ;;
    "")
      tail -n 50 "$LOG_FILE"
      ;;
    *)
      die "usage: auckland-vpn log [-f]"
      ;;
  esac
}

# Store the TOTP secret (base32 string, or a full otpauth:// URI from a QR
# decoder) in a mode-600 file openconnect reads with --token-secret=@FILE.
cmd_secret() {
  ensure_config_dir
  echo "Paste your TOTP secret."
  echo "  - a base32 string like JBSWY3DPEHPK3PXP, or"
  echo "  - a full otpauth://totp/... URI (if you decoded the enrolment QR)"
  printf "> "
  read -r RAW
  RAW="$(echo "$RAW" | tr -d '[:space:]')"
  [ -z "$RAW" ] && die "no secret entered; aborted."
  if [[ "$RAW" == otpauth://* ]]; then
    SECRET="$RAW"
  else
    SECRET="base32:${RAW#base32:}"
  fi
  # Atomic rename into place (no partial file, no symlink following).
  write_secret_file "$SECRET_FILE" "$SECRET"
  echo "Saved TOTP secret to $SECRET_FILE (mode 600)."
}

# Append VPN_USER=<value> to the config file atomically (fresh copy in the
# same dir, mode 600, rename into place — no partial file, no symlink chase).
save_vpn_user_to_config() {
  ensure_config_dir
  local tmp existing=""
  if [ -f "$CONFIG_FILE" ]; then
    existing="$(cat "$CONFIG_FILE")"
  fi
  tmp="$(mktemp "$CONFIG_DIR/.auckland-vpn.XXXXXX")" || die "cannot create temp file in $CONFIG_DIR"
  if ! { { [ -n "$existing" ] && printf '%s\n' "$existing"; printf 'VPN_USER=%s\n' "$VPN_USER"; } >"$tmp" \
       && chmod 600 "$tmp" && mv -f "$tmp" "$CONFIG_FILE"; }; then
    rm -f "$tmp"
    die "could not update $CONFIG_FILE"
  fi
}

cmd_setup() {
  # setup can bootstrap the username itself (start/setup-sudo only refuse).
  if [ -z "$VPN_USER" ]; then
    printf 'University username: '
    read -r VPN_USER || true   # EOF must fall through to the empty check below
    VPN_USER="${VPN_USER#"${VPN_USER%%[![:space:]]*}"}"
    VPN_USER="${VPN_USER%"${VPN_USER##*[![:space:]]}"}"
    [ -n "$VPN_USER" ] || die "no username entered; aborted."
    save_vpn_user_to_config
    echo "Saved VPN_USER=$VPN_USER to $CONFIG_FILE"
    echo
  fi
  cmd_secret
  echo
  echo "Enter your University of Auckland password."
  echo "It is stored in your macOS Keychain (you'll get a system prompt to allow it)."
  read -rs -p "> " PASS; echo
  # Trim stray whitespace: a pasted trailing space is a stored bad credential.
  PASS="${PASS#"${PASS%%[![:space:]]*}"}"
  PASS="${PASS%"${PASS##*[![:space:]]}"}"
  [ -z "$PASS" ] && die "no password entered; aborted."
  # Keychain errors go to our private state dir — this tool must not leave
  # files in /tmp (world-writable, wiped on reboot).
  ensure_state_dir
  local keyerr="$STATE_DIR/keychain-error.txt"
  if security add-generic-password -a "$VPN_USER" -s "$KEYCHAIN_SVC" -w "$PASS" -U 2>"$keyerr"; then
    rm -f "$keyerr"
    # Keychain now holds the CURRENT password; a leftover file from an earlier
    # fallback would be ignored anyway (Keychain wins) — delete it so it can't
    # resurface later.
    rm -f "$PASSWORD_FILE"
    echo "Password saved to macOS Keychain."
  else
    echo "Keychain unavailable ($(head -n 1 "$keyerr" 2>/dev/null || true))."
    rm -f "$keyerr"   # diagnostics shown; don't leave the file behind
    echo "Falling back to a protected file instead."
    write_secret_file "$PASSWORD_FILE" "$PASS"
    echo "Password saved to $PASSWORD_FILE (mode 600)."
    # start prefers the Keychain entry when one exists, so a stale one would
    # silently override this fresh password. Warn with the exact fix.
    if security find-generic-password -a "$VPN_USER" -s "$KEYCHAIN_SVC" >/dev/null 2>&1; then
      echo "WARNING: an older Keychain entry still exists and will be PREFERRED over this file."
      echo "Remove it with: security delete-generic-password -a '$VPN_USER' -s '$KEYCHAIN_SVC'"
    fi
  fi
  echo
  echo "Optional: let 'auckland-vpn start' run without typing your Mac password."
  printf 'Install the restricted sudo helper now? [y/N] '
  read -r reply || true
  case "$reply" in
    y|Y) echo; cmd_setup_sudo ;;
    *)   echo; print_sudoers_hint ;;
  esac
  echo
  echo "Setup complete. Connect with:  auckland-vpn start"
}

# Stored VPN password: Keychain first, else the protected-file fallback.
# Prints the password (possibly empty); callers decide how to fail.
stored_vpn_password() {
  security find-generic-password -a "$VPN_USER" -s "$KEYCHAIN_SVC" -w 2>/dev/null || true
}

# TOTP secret exactly as the helper expects it on stdin: first line of the
# secret file with ALL whitespace stripped.
read_token_secret() {
  head -n 1 "$SECRET_FILE" 2>/dev/null | tr -d '[:space:]'
}

# Pipe credentials to ONE passwordless 'helper start'. On failure returns
# sudo's exit status and captures its stderr in HELPER_START_ERR for the
# caller to classify — shared by cmd_start and the monitor's heal path so
# both drive the identical privileged surface.
HELPER_START_ERR=""
try_helper_start_n() { # try_helper_start_n <password> <token>
  HELPER_START_ERR="$(printf '%s\n%s\n' "$1" "$2" | "$SUDO_BIN" -n "$HELPER_BIN" start 2>&1 >/dev/null)"
}

cmd_start() {
  # Gates first, in the right order: who are you, is everything installed —
  # all BEFORE any sudo interaction (a missing binary must never masquerade
  # as a sudo problem).
  require_vpn_user
  require_prereqs
  [ -s "$SECRET_FILE" ] || die "TOTP secret missing. Run: auckland-vpn setup"
  # Password: Keychain first, then the protected-file fallback.
  PASS="$(stored_vpn_password)"
  if [ -z "$PASS" ] && [ -s "$PASSWORD_FILE" ]; then
    PASS="$(cat "$PASSWORD_FILE")"
  fi
  [ -z "$PASS" ] && die "VPN password not found (Keychain or $PASSWORD_FILE). Run: auckland-vpn setup"
  # The helper frames credentials as TWO newline-terminated stdin records
  # (password, then TOTP secret); a raw newline inside the password would
  # corrupt that framing. Reject it here, before anything is piped. \r and
  # spaces pass through unchanged.
  case "$PASS" in
    *$'\n'*) die "stored password contains a newline — re-run: auckland-vpn setup" ;;
  esac
  if [ ! -x "$HELPER_BIN" ]; then
    print_sudoers_hint
    exit 1
  fi
  refuse_if_already_running
  ensure_state_dir
  # From here the VPN is WANTED up: the monitor may heal it if it dies.
  # ('stop' clears this; the monitor's own internal stop does not.)
  : >"$MONITOR_ENABLED_FILE"

  # The helper receives TWO newline-terminated stdin records: password then
  # TOTP secret. Reading the secret HERE (not in the helper) means root never
  # opens any user-owned path. Newline framing is safe because 'setup' strips
  # all whitespace from the stored secret.
  local token
  token="$(read_token_secret)"
  [ -n "$token" ] || die "TOTP secret at $SECRET_FILE is empty — re-run: auckland-vpn setup"

  echo "Connecting to $VPN_SERVER as $VPN_USER ..."
  # Attempt the REAL command non-interactively first — 'sudo -n true' would
  # always fail under our exact-args sudoers rule (only 'helper start'/'stop'
  # are allowed, not arbitrary commands), and a cached root timestamp proves
  # nothing about the rule. Classify the failure by stderr: "a password is
  # required" means the rule isn't (yet) usable → ask once via plain sudo;
  # any other failure (helper died, bad args, sudoers denial) is reported
  # from the log instead of being misread as a missing password prompt.
  local passwordless=1
  if ! try_helper_start_n "$PASS" "$token"; then
    if [ -t 0 ] && [[ "$HELPER_START_ERR" == *"a password is required"* ]]; then
      passwordless=0
      echo "(Passwordless sudo not set up — asking for your Mac password once.)"
      if ! printf '%s\n%s\n' "$PASS" "$token" | "$SUDO_BIN" "$HELPER_BIN" start; then
        report_start_failure   # exits
      fi
    else
      [ -n "$HELPER_START_ERR" ] && echo "$HELPER_START_ERR" >&2
      report_start_failure   # exits
    fi
  fi

  # Launch succeeded; now confirm the tunnel actually came up before any
  # green light (wrong password / expired TOTP surface here).
  if ! verify_tunnel_started; then
    report_start_failure   # exits
  fi

  # A deliberate manual start is an explicit user decision: clear any open
  # auto-heal circuit breaker / backoff history (consult §backoff and
  # circuit breaker). Ordinary network events must NOT clear it.
  reset_monitor_history

  local ip
  ip="$(tunnel_ip_from_log || true)"
  if [ -n "$ip" ]; then
    echo "Connected as $VPN_USER. Tunnel IP: $ip"
  else
    echo "Connected as $VPN_USER."
  fi
  if [ "$passwordless" -eq 0 ]; then
    echo "Tip: run 'auckland-vpn setup-sudo' once to connect without your Mac password."
  fi
}

cmd_stop() {
  # An explicit user stop means the VPN is NO LONGER wanted up: clear the
  # monitor's intent first thing (even on the early "nothing running" path),
  # so the monitor never resurrects a tunnel the user stopped.
  rm -f "$MONITOR_ENABLED_FILE" 2>/dev/null || true
  # Nothing to stop (no live process, no non-empty pidfile): say so without
  # bothering sudo — keeps 'restart' quiet when nothing was running. The
  # pidfile persists across stops, so an EMPTY record is a normal "nothing
  # running" state, not an error.
  local pid
  pid="$(running_vpn_pid || true)"
  if [ -z "$pid" ] && [ ! -s "$PID_FILE" ]; then
    echo "Not connected."
    return 0
  fi
  # Preferred path: the root-owned helper kills the exact recorded PID.
  if [ -x "$HELPER_BIN" ]; then
    if "$SUDO_BIN" -n "$HELPER_BIN" stop; then
      return 0
    fi
    # NEVER pattern-kill when a pidfile exists: the exact-PID guarantee is the
    # point of the helper, and a broad pkill can signal another user's (or a
    # stale) openconnect. Surface the failure instead.
    echo "Warning: '$HELPER_BIN stop' failed (missing/stale/corrupt pidfile," >&2
    echo "         or sudoers rule?). NOT pattern-killing — fix the helper:" >&2
    echo "           auckland-vpn setup-sudo" >&2
    return 1
  fi
  # Fallback ONLY while no helper is installed at all: kill by pattern. The
  # [o] character class stops our OWN argv chain from matching — a plain 'pkill
  # -f' run via sudo sees the pattern inside sudo's argv, killed its own parent,
  # and made 'stop' die with a false "could not stop openconnect".
  stop_legacy_fallback
}

# Fallback when no helper is installed (or it failed): kill by pattern. The
# [o] character class stops our OWN argv chain from matching — a plain 'pkill
# -f' run via sudo sees the pattern inside sudo's argv, killed its own parent,
# and made 'stop' die with a false "could not stop openconnect".
stop_legacy_fallback() {
  local pat="[o]penconnect.*$VPN_HOST" waited=0
  if pgrep -f "$pat" >/dev/null 2>&1; then
    echo "Warning: helper unavailable; killing openconnect by pattern." >&2
    echo "         Run 'auckland-vpn setup-sudo' for the safe per-PID stop." >&2
    "$SUDO_BIN" pkill -f "$pat" || die "could not stop openconnect."
    # pkill only SIGNALS; confirm the process is really gone before claiming
    # success (bounded ~5 s).
    while pgrep -f "$pat" >/dev/null 2>&1; do
      if [ "$waited" -ge 10 ]; then
        echo "Warning: openconnect still running after ~5s — check: pgrep -fl openconnect" >&2
        return 1
      fi
      sleep 0.5
      waited=$((waited + 1))
    done
    echo "Disconnected."
  else
    echo "Not connected."
  fi
}

# restart = stop, wait out the old process (best-effort: see
# wait_until_vpn_gone), then start. cmd_start's already-running guard is the
# actual guarantee that a survivor cannot race a second tunnel.
cmd_restart() {
  cmd_stop
  wait_until_vpn_gone
  cmd_start
}

# ---- Monitor / auto-heal -----------------------------------------------------
# Promoted from the verified prototypes/monitor state machine (issue #14;
# design spec: docs/consults/reliability.md). An opt-in foreground supervisor:
#
#   * every INTERVAL seconds it classifies the tunnel as healthy /
#     reconnecting / degraded / dead using unprivileged signals only —
#     pidfile PID alive AND its argv is our openconnect, a utun interface
#     carrying the tunnel IP, and an end-to-end DNS probe through the VPN
#     resolver compared against the system resolver;
#   * while the VPN is WANTED (see intent below) and stays broken past the
#     grace windows, it heals by driving the EXISTING privileged surface —
#     'sudo -n helper stop' then the same credential plumbing 'start' uses —
#     so the sudoers grant stays byte-identical;
#   * exponential backoff between attempts (0..600s, capped at BACKOFF_CAP),
#     a circuit breaker after MAX_RESTART_ATTEMPTS failures, and best-effort
#     osascript notifications with fixed literal messages.
#
# Intent ("desired state"): 'start'/'restart' mark the VPN wanted via
# MONITOR_ENABLED_FILE; an explicit user 'stop' clears it. The monitor never
# resurrects a tunnel the user stopped (the consult's rejected-shortcut #4).
#
# AUCKLAND_VPN_DRY_RUN=1 makes healing log the would-be commands without
# invoking sudo — this is what the test suite exercises.
INTERVAL=${INTERVAL:-20}                          # poll period (s)
RECONNECT_GRACE=${RECONNECT_GRACE:-90}            # wedged-PID patience (s)
DEGRADED_THRESHOLD=${DEGRADED_THRESHOLD:-2}       # consecutive DNS failures
DEGRADED_GRACE=${DEGRADED_GRACE:-120}             # degraded dwell before heal (s)
NETWORK_SETTLE_GRACE=${NETWORK_SETTLE_GRACE:-30}  # post-death/wake settle (s)
MAX_RESTART_ATTEMPTS=${MAX_RESTART_ATTEMPTS:-5}   # circuit opens after N tries
CIRCUIT_COOLDOWN=${CIRCUIT_COOLDOWN:-3600}        # breaker cool-down (s)
BACKOFF_CAP=${BACKOFF_CAP:-900}                   # restart backoff cap (15 min)

# In-memory mirror of the persisted counters (see save/load below).
current_state=unknown
bad_since=0 degraded_count=0 restart_attempts=0 next_attempt=0
circuit_until=0 healthy_count=0

# Refuse nonsense thresholds up front: every one of these lands in arithmetic
# or test contexts where garbage would fail obscurely later.
monitor_validate_config() {
  local v
  for v in "$INTERVAL" "$RECONNECT_GRACE" "$DEGRADED_THRESHOLD" \
           "$DEGRADED_GRACE" "$NETWORK_SETTLE_GRACE" \
           "$MAX_RESTART_ATTEMPTS" "$CIRCUIT_COOLDOWN" "$BACKOFF_CAP"; do
    case "$v" in
      ''|*[!0-9]*) die "monitor: threshold '$v' is not a non-negative integer" ;;
    esac
  done
}

# Single-monitor lock: atomic mkdir (flock is not stock macOS), with a PID
# marker so only a provably-dead owner's lock is ever taken over.
monitor_lock_acquire() {
  local holder tries=0
  until mkdir "$MONITOR_LOCK_DIR" 2>/dev/null; do
    tries=$((tries + 1))
    [ "$tries" -le 5 ] || die "cannot acquire the monitor lock at $MONITOR_LOCK_DIR.
If no monitor is running, remove it:  rm -rf '$MONITOR_LOCK_DIR'"
    holder="$(cat "$MONITOR_LOCK_DIR/pid" 2>/dev/null || true)"
    case "$holder" in
      ''|*[!0-9]*)
        sleep 0.2 ;;   # owner may sit in its mkdir→write-pid window; wait it out
      *)
        if kill -0 "$holder" 2>/dev/null; then
          die "another monitor is already running (pid $holder)."
        fi
        rm -f "$MONITOR_LOCK_DIR/pid"
        rmdir "$MONITOR_LOCK_DIR" 2>/dev/null || true
        ;;
    esac
  done
  printf '%s\n' "$$" >"$MONITOR_LOCK_DIR/pid"
}

# Runs from EXIT/HUP/INT/TERM traps: remove ONLY a lock we own ourselves.
monitor_lock_release() {
  if [ "$(cat "$MONITOR_LOCK_DIR/pid" 2>/dev/null || true)" = "$$" ]; then
    rm -f "$MONITOR_LOCK_DIR/pid"
    rmdir "$MONITOR_LOCK_DIR" 2>/dev/null || true
  fi
  return 0
}

# Atomically persist the counters: mktemp in STATE_DIR (same filesystem =>
# rename works), mode 600 via chmod, then rename into place — the established
# private-write pattern of this script. Readers NEVER source this file.
save_monitor_state() {
  local tmp
  tmp="$(mktemp "$STATE_DIR/.monitor-state.XXXXXX")" || return 1
  if {
    printf 'current_state=%s\n' "$current_state"
    printf 'bad_since=%s\n' "$bad_since"
    printf 'degraded_count=%s\n' "$degraded_count"
    printf 'restart_attempts=%s\n' "$restart_attempts"
    printf 'next_attempt=%s\n' "$next_attempt"
    printf 'circuit_until=%s\n' "$circuit_until"
    printf 'healthy_count=%s\n' "$healthy_count"
  } >"$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$MONITOR_STATE_FILE"; then
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# Load persisted counters conservatively: fields are validated into LOCALS
# first and committed ONLY if the whole file parses — a corrupt field leaves
# the entry defaults untouched and reports corruption to the caller. Never
# sources or evaluates file content.
load_monitor_state() {
  local t_cur=unknown t_bad=0 t_deg=0 t_att=0 t_nxt=0 t_cir=0 t_heal=0
  current_state=unknown
  bad_since=0 degraded_count=0 restart_attempts=0 next_attempt=0
  circuit_until=0 healthy_count=0
  [ -f "$MONITOR_STATE_FILE" ] || return 0
  local line k v
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in *=*) ;; *) continue ;; esac
    k="${line%%=*}"
    v="${line#*=}"
    case "$k" in
      current_state)
        case "$v" in
          healthy|degraded|reconnecting|dead|unknown|verifying|circuit_open|idle) t_cur="$v" ;;
          *) return 1 ;;
        esac
        ;;
      bad_since|degraded_count|restart_attempts|next_attempt|circuit_until|healthy_count)
        case "$v" in
          ''|*[!0-9]*) return 1 ;;
        esac
        case "$k" in
          bad_since)         t_bad="$v" ;;
          degraded_count)    t_deg="$v" ;;
          restart_attempts)  t_att="$v" ;;
          next_attempt)      t_nxt="$v" ;;
          circuit_until)     t_cir="$v" ;;
          healthy_count)     t_heal="$v" ;;
        esac
        ;;
      *) ;;   # unknown keys are forward-compat noise, not corruption
    esac
  done <"$MONITOR_STATE_FILE"
  current_state="$t_cur"
  bad_since="$t_bad" degraded_count="$t_deg" restart_attempts="$t_att"
  next_attempt="$t_nxt" circuit_until="$t_cir" healthy_count="$t_heal"
}

# Manual start = explicit user decision: forget breaker/backoff history.
reset_monitor_history() {
  [ -d "$STATE_DIR" ] || return 0
  current_state=healthy
  bad_since=0 degraded_count=0 restart_attempts=0 next_attempt=0
  circuit_until=0 healthy_count=2
  save_monitor_state || true
}

# Append a timestamped transition to the private monitor log; rotate past
# ~256 KiB keeping one old generation (consult §notifications and logs).
monitor_log() {
  if [ -f "$MONITOR_LOG" ] \
      && [ "$(stat -f '%z' "$MONITOR_LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
    mv -f "$MONITOR_LOG" "$MONITOR_LOG.old" 2>/dev/null || true
  fi
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$MONITOR_LOG"
}

# Best-effort macOS notification. FIXED literal messages only — callers must
# never interpolate log text or dynamic values into AppleScript source
# (consult §notifications). Never changes monitor state; skipped entirely in
# dry-run (and therefore in tests).
notify_user() {
  [ "${AUCKLAND_VPN_DRY_RUN:-}" = "1" ] && return 0
  [ -x /usr/bin/osascript ] || return 0
  /usr/bin/osascript -e "display notification \"$1\" with title \"Auckland VPN\"" >/dev/null 2>&1 || true
  return 0
}

# The recorded pidfile PID belongs to THIS VPN right now: numeric, alive,
# and its command line names both openconnect and our server (guards against
# PID reuse — kill -0 alone proves nothing). Prints the PID on success.
valid_vpn_pid() {
  local pid command
  pid="$(cat "$PID_FILE" 2>/dev/null)" || pid=""
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  command="$(ps -p "$pid" -o command= 2>/dev/null)" || return 1
  case "$command" in
    *openconnect*"$VPN_SERVER"*) printf '%s\n' "$pid" ;;
    *) return 1 ;;
  esac
}

# Map a tunnel IPv4 to the utun interface actually carrying it (never assume
# "highest utun" — macOS and other VPN products create utuns too).
tunnel_interface() { # tunnel_interface <ipv4>
  [ -n "$1" ] || return 1
  /sbin/ifconfig -a 2>/dev/null | /usr/bin/awk -v ip="$1" '
    /^[[:alnum:]]+:/ { iface=$1; sub(/:$/, "", iface) }
    $1 == "inet" && $2 == ip && iface ~ /^utun[0-9]+$/ { print iface; exit }
  '
}

# Interface a destination routes through (route -n get avoids DNS for IPs).
route_interface() { # route_interface <ip-or-host>
  [ -n "$1" ] || return 1
  /sbin/route -n get "$1" 2>/dev/null |
    /usr/bin/awk '$1 == "interface:" { print $2; exit }'
}

# Answer-shape policy: accept RFC1918 answers. Production hardening would pin
# an exact allow-list for the chosen University health record (prototype
# policy carried over deliberately).
expected_answer() {
  /usr/bin/awk '
    /^10\./ { found=1 }
    /^192\.168\./ { found=1 }
    /^172\.(1[6-9]|2[0-9]|3[01])\./ { found=1 }
    END { exit(found ? 0 : 1) }
  '
}

# Direct probe: the VPN DNS server itself answers for the health host
# (validates the ANSWER, not merely dig's exit status).
direct_dns_ok() {
  [ -n "$VPN_DNS_SERVER" ] && [ -n "$VPN_HEALTH_HOST" ] || return 1
  /usr/bin/dig +time=2 +tries=1 +short A \
    @"$VPN_DNS_SERVER" "$VPN_HEALTH_HOST" 2>/dev/null | expected_answer
}

# System path: what applications ACTUALLY resolve via macOS resolver config.
system_dns_ok() {
  [ -n "$VPN_HEALTH_HOST" ] || return 1
  /usr/bin/dscacheutil -q host -a name "$VPN_HEALTH_HOST" 2>/dev/null |
    /usr/bin/awk '$1 == "ip_address:" { print $2 }' | expected_answer
}

# classify_state PROCESS_OK TUNNEL_OK ROUTE_OK DIRECT_DNS_OK SYSTEM_DNS_OK
# Pure classifier (prototype contract kept; unit-tested directly).
classify_state() {
  local process_ok=$1 tunnel_ok=$2 route_ok=$3 direct_ok=$4 system_ok=$5
  [ "$process_ok" -eq 1 ] || { echo dead; return 0; }
  if [ "$tunnel_ok" -ne 1 ] || [ "$route_ok" -ne 1 ]; then
    echo reconnecting
  elif [ "$direct_ok" -ne 1 ] || [ "$system_ok" -ne 1 ]; then
    echo degraded
  else
    echo healthy
  fi
}

observe_state() {
  local process_ok=0 tunnel_ok=0 route_ok=0 direct_ok=0 system_ok=0
  local tunnel_if probe_if tip="${TUNNEL_IP:-}"

  # High-confidence death FIRST: a pidfile PID that is gone or no longer our
  # openconnect is decisive even without deep-probe configuration — this is
  # the one state auto-heal may trust unconfigured (consult §health model).
  if valid_vpn_pid >/dev/null 2>&1; then
    process_ok=1
  else
    echo dead
    return 0
  fi

  # Deep probes need configuration; otherwise report unknown honestly and
  # heal nothing beyond the high-confidence death above. TUNNEL_IP comes from
  # the environment when injected (tests/fixtures), else this attempt's log.
  [ -n "$tip" ] || tip="$(tunnel_ip_from_log || true)"
  if [ -z "$VPN_HEALTH_IP" ] || [ -z "$VPN_HEALTH_HOST" ] ||
      [ -z "$VPN_DNS_SERVER" ] || [ -z "$tip" ]; then
    echo unknown
    return 0
  fi

  tunnel_if="$(tunnel_interface "$tip" 2>/dev/null || true)"
  [ -n "$tunnel_if" ] && tunnel_ok=1
  probe_if="$(route_interface "$VPN_HEALTH_IP" 2>/dev/null || true)"
  { [ -n "$tunnel_if" ] && [ "$probe_if" = "$tunnel_if" ]; } && route_ok=1
  if direct_dns_ok; then direct_ok=1; fi
  if system_dns_ok; then system_ok=1; fi

  classify_state "$process_ok" "$tunnel_ok" "$route_ok" "$direct_ok" "$system_ok"
}

# Exponential restart backoff in seconds; capped at BACKOFF_CAP (task spec:
# 15 min — supersedes the consult draft's 10-minute figure).
backoff_seconds() {
  case "$1" in
    1) echo 0 ;;
    2) echo 30 ;;
    3) echo 60 ;;
    4) echo 120 ;;
    5) echo 300 ;;
    6) echo 600 ;;
    *) echo "$BACKOFF_CAP" ;;
  esac
}

reset_healthy_counters() {
  bad_since=0 degraded_count=0 restart_attempts=0 next_attempt=0
  circuit_until=0 healthy_count=2
}

# state_machine_step OBSERVED_STATE EPOCH_SECONDS -> one key=value record.
# Emits actions as TEXT; execution happens only in monitor_act. This purity
# is what makes the machine unit-testable (prototype contract kept).
state_machine_step() {
  local observed=$1 now=$2 grace=0 delay

  if [ "$circuit_until" -gt "$now" ]; then
    current_state=circuit_open
    printf 'state=circuit_open retry_at=%s\n' "$circuit_until"
    return 0
  fi

  case "$observed" in
    healthy)
      healthy_count=$((healthy_count + 1))
      bad_since=0
      degraded_count=0
      if [ "$healthy_count" -lt 2 ]; then
        current_state=verifying
        echo 'state=verifying action=wait healthy_checks=1'
      else
        reset_healthy_counters
        current_state=healthy
        echo 'state=healthy'
      fi
      return 0
      ;;
    unknown)
      bad_since=0
      degraded_count=0
      current_state=unknown
      echo 'state=unknown action=none'
      return 0
      ;;
    degraded)
      degraded_count=$((degraded_count + 1))
      grace=$DEGRADED_GRACE
      ;;
    reconnecting)
      degraded_count=0
      grace=$RECONNECT_GRACE
      ;;
    dead)
      degraded_count=0
      grace=$NETWORK_SETTLE_GRACE
      ;;
    *)
      echo "state=unknown action=none reason=invalid_observation" >&2
      return 2
      ;;
  esac
  healthy_count=0

  [ "$bad_since" -ne 0 ] || bad_since=$now
  current_state=$observed

  # One failed probe is an observation, not a transition: hysteresis first
  # (consecutive DNS failures), then the state's grace window, then backoff.
  if [ "$observed" = degraded ] &&
      [ "$degraded_count" -lt "$DEGRADED_THRESHOLD" ]; then
    printf 'state=degraded action=wait dns_failures=%s\n' "$degraded_count"
    return 0
  fi
  if [ $((now - bad_since)) -lt "$grace" ]; then
    printf 'state=%s action=wait grace_remaining=%s\n' \
      "$observed" "$((grace - (now - bad_since)))"
    return 0
  fi
  if [ "$next_attempt" -gt "$now" ]; then
    printf 'state=%s action=backoff retry_at=%s\n' "$observed" "$next_attempt"
    return 0
  fi

  restart_attempts=$((restart_attempts + 1))
  if [ "$restart_attempts" -gt "$MAX_RESTART_ATTEMPTS" ]; then
    circuit_until=$((now + CIRCUIT_COOLDOWN))
    current_state=circuit_open
    printf 'state=circuit_open action=notify retry_at=%s\n' "$circuit_until"
    return 0
  fi

  delay="$(backoff_seconds "$restart_attempts")"
  next_attempt=$((now + delay))
  bad_since=$now
  printf 'state=%s action=WOULD_RESTART attempt=%s next_delay=%s\n' \
    "$observed" "$restart_attempts" "$delay"
}

monitor_intent_up() {
  [ -f "$MONITOR_ENABLED_FILE" ]
}

# Basic outer readiness before any futile start: the public gateway must NOT
# route through the tunnel and must be reachable (scutil, not ICMP). This
# prevents obviously doomed starts behind captive portals or dead Wi-Fi; it
# does NOT prove general Internet health (consult §auto-heal).
monitor_network_ready() {
  local gw_if
  gw_if="$(route_interface "$VPN_HOST" 2>/dev/null || true)"
  case "$gw_if" in ''|utun[0-9]*) return 1 ;; esac
  /usr/sbin/scutil -r "$VPN_HOST" 2>/dev/null | /usr/bin/grep -q Reachable
}

# One heal cycle over the EXISTING privileged surface only: helper stop,
# wait out the old process (best-effort), helper start with stored
# credentials (identical plumbing to cmd_start via try_helper_start_n).
# Returns 0 ok/dry-run/deferred, 1 failed
# attempt, 3 stop refused (consult: enter the circuit breaker).
monitor_heal() {
  local pass token stop_rc=0
  if [ "${AUCKLAND_VPN_DRY_RUN:-}" = "1" ]; then
    echo "[dry-run] would run: $SUDO_BIN -n $HELPER_BIN stop"
    echo "[dry-run] would run: $SUDO_BIN -n $HELPER_BIN start (with stored credentials)"
    return 0
  fi
  if ! monitor_network_ready; then
    monitor_log "heal=deferred reason=network-not-ready"
    echo "monitor: network not ready (gateway unreachable or mis-routed) — deferring heal."
    return 0
  fi

  # STOP phase — never via cmd_stop, which would clear the user's intent.
  if [ -x "$HELPER_BIN" ]; then
    "$SUDO_BIN" -n "$HELPER_BIN" stop >/dev/null 2>&1 || stop_rc=$?
    if [ "$stop_rc" -ne 0 ]; then
      monitor_log "heal=stop-refused rc=$stop_rc"
      notify_user "VPN auto-heal paused: helper refused stop (stale pidfile?)"
      return 3
    fi
  fi
  wait_until_vpn_gone

  # START phase with the SAME credential lookups cmd_start performs.
  if [ -z "$VPN_USER" ]; then
    monitor_log "heal=blocked reason=no-username"
    notify_user "VPN auto-heal blocked: no username configured — run: auckland-vpn setup"
    return 1
  fi
  pass="$(stored_vpn_password)"
  if [ -z "$pass" ] && [ -s "$PASSWORD_FILE" ]; then
    pass="$(cat "$PASSWORD_FILE")"
  fi
  if [ -z "$pass" ]; then
    monitor_log "heal=blocked reason=no-password"
    notify_user "VPN auto-heal blocked: no stored password — run: auckland-vpn setup"
    return 1
  fi
  case "$pass" in
    *$'\n'*)
      monitor_log "heal=blocked reason=password-newline"
      notify_user "VPN auto-heal blocked: stored password unusable — run: auckland-vpn setup"
      return 1
      ;;
  esac
  token="$(read_token_secret)"
  if [ -z "$token" ]; then
    monitor_log "heal=blocked reason=no-totp"
    notify_user "VPN auto-heal blocked: no TOTP secret — run: auckland-vpn setup"
    return 1
  fi

  if ! try_helper_start_n "$pass" "$token"; then
    if [[ "$HELPER_START_ERR" == *"a password is required"* ]]; then
      monitor_log "heal=blocked reason=sudo-password-required"
      notify_user "VPN auto-heal blocked: passwordless sudo unavailable — run: auckland-vpn setup-sudo"
    else
      monitor_log "heal=start-failed"
      notify_user "VPN automatic restart failed — see auckland-vpn log"
    fi
    return 1
  fi

  if verify_tunnel_started >/dev/null 2>&1; then
    monitor_log "heal=recovered"
    notify_user "VPN connection recovered automatically"
    return 0
  fi
  monitor_log "heal=start-unverified"
  notify_user "VPN restarted automatically but health is unconfirmed"
  return 1
}

# Execute an emitted action record — the ONLY place healing becomes real.
monitor_act() { # monitor_act <record-line>
  local record="$1" action
  case "$record" in *action=*) ;; *) return 0 ;; esac
  action="${record#*action=}"
  action="${action%% *}"
  case "$action" in
    WOULD_RESTART)
      if ! monitor_intent_up; then
        echo "monitor: tunnel down but 'start' did not mark it wanted — not healing."
        monitor_log "skip=intent-down"
        return 0
      fi
      monitor_heal
      ;;
    notify)
      notify_user "VPN auto-heal paused after repeated failures (circuit open)"
      return 0
      ;;
    *) return 0 ;;
  esac
}

cmd_monitor() {
  local once=0 observed now record
  case "${1:-}" in
    "") : ;;
    --once) once=1 ;;
    *) die "usage: auckland-vpn monitor [--once]" ;;
  esac
  [ "$(id -u)" -ne 0 ] || die "run the monitor as your own user, not root (it needs YOUR Keychain)."
  monitor_validate_config
  ensure_state_dir
  monitor_lock_acquire
  trap monitor_lock_release EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  load_monitor_state || monitor_log "state=corrupt action=reset"
  [ -x "$HELPER_BIN" ] || echo "warning: helper not installed ($HELPER_BIN) — observing only, healing disabled. Run: auckland-vpn setup-sudo" >&2

  # Foreground poll loop (default interval 20s). Sleep naturally resumes at
  # wake, so each pass observes immediately after suspend/network changes;
  # the state machine's NETWORK_SETTLE_GRACE supplies the wake-settle patience
  # the consult asks for — no private macOS event APIs involved.
  local rec="$STATE_DIR/.monitor-rec"
  while :; do
    observed="$(observe_state)"
    now="$(date +%s)"
    if ! monitor_intent_up && [ "$observed" != healthy ]; then
      # Desired down (or never started via 'start'): never probe-and-heal.
      current_state=idle
      record="state=idle action=none reason=intent-down"
    else
      # Captured via redirect, NOT command substitution: $( ) would run the
      # step in a subshell and silently DISCARD the counter mutations that
      # drive backoff and the circuit breaker.
      state_machine_step "$observed" "$now" >"$rec" || true
      record="$(cat "$rec")"
      rm -f "$rec"
    fi
    echo "monitor: observation=$observed $record"
    case "$record" in
      *action=WOULD_RESTART*|*action=notify*)
        if ! monitor_act "$record"; then
          monitor_log "act=failed record=$record"
        fi
        ;;
    esac
    monitor_log "observation=$observed $record"
    save_monitor_state || monitor_log "warn=state-save-failed"
    if [ "$once" -eq 1 ]; then break; fi
    sleep "$INTERVAL"
  done
}


cmd_pin() {
  command -v openssl >/dev/null 2>&1 \
    || die "openssl not found (macOS ships it at /usr/bin/openssl)."
  local fp
  # pipefail + an explicit emptiness check: a failed fetch must say WHY it is
  # failing instead of exiting silently via a swallowed pipeline status.
  fp="$(echo | openssl s_client -connect "$VPN_HOST:443" -servername "$VPN_HOST" 2>/dev/null \
        | awk '/-----BEGIN CERTIFICATE-----/{f=1} f{print} /-----END CERTIFICATE-----/{exit}' \
        | openssl x509 -noout -fingerprint -sha256 2>/dev/null \
        | sed 's/.*Fingerprint=//' | tr -d ':' | awk '{print "sha256:"$1}')" \
    || die "could not fetch certificate for $VPN_HOST (network/DNS up?)"
  [ -n "$fp" ] || die "could not fetch certificate for $VPN_HOST (network/DNS up?)"
  printf '%s\n' "$fp"
}

# One command that names everything broken, with the exact fix for each.
# Prints one line per check — "OK <thing>" or "FIX <thing> — <exact
# command>" — and exits non-zero when anything needs fixing. Read-only except
# for a throwaway write test in the state dir; never prompts for sudo.
cmd_doctor() {
  local fixes=0 last_err
  if [ -n "$VPN_USER" ]; then
    echo "OK   username set (VPN_USER=$VPN_USER)"
  else
    echo "FIX  username not set — run: auckland-vpn setup   (or: export VPN_USER=yourname)"
    fixes=$((fixes + 1))
  fi

  if [ -n "$OPENCONNECT_BIN" ] && [ -x "$OPENCONNECT_BIN" ]; then
    echo "OK   openconnect found at $OPENCONNECT_BIN"
  else
    echo "FIX  openconnect not found — install with: brew install openconnect"
    fixes=$((fixes + 1))
  fi

  if [ -n "$SCRIPT_PATH" ] && [ -x "$SCRIPT_PATH" ]; then
    echo "OK   vpnc-script found at $SCRIPT_PATH"
  else
    echo "FIX  vpnc-script missing — reinstall with: brew install openconnect (it provides etc/vpnc/vpnc-script)"
    fixes=$((fixes + 1))
  fi

  if [ -s "$SECRET_FILE" ]; then
    echo "OK   TOTP secret present at $SECRET_FILE"
  else
    echo "FIX  TOTP secret missing or empty — run: auckland-vpn setup"
    fixes=$((fixes + 1))
  fi

  if [ -n "$VPN_USER" ] \
      && security find-generic-password -a "$VPN_USER" -s "$KEYCHAIN_SVC" >/dev/null 2>&1; then
    echo "OK   VPN password in macOS Keychain (service $KEYCHAIN_SVC)"
  elif [ -s "$PASSWORD_FILE" ]; then
    echo "OK   VPN password file present at $PASSWORD_FILE"
  else
    echo "FIX  VPN password not found (Keychain or $PASSWORD_FILE) — run: auckland-vpn setup"
    fixes=$((fixes + 1))
  fi

  if [ ! -x "$HELPER_BIN" ]; then
    echo "FIX  privileged helper missing — 'start' refuses until it is installed. Install with: auckland-vpn setup-sudo"
    fixes=$((fixes + 1))
  elif "$SUDO_BIN" -n -l "$HELPER_BIN start" >/dev/null 2>&1 && "$SUDO_BIN" -n -l "$HELPER_BIN stop" >/dev/null 2>&1; then
    # -l <cmd> exits 0 only when sudoers policy actually allows the command;
    # checking BOTH exact invocations avoids false OK from generic privileges.
    echo "OK   helper installed ($HELPER_BIN) and passwordless sudo allows it"
  else
    echo "FIX  helper installed but sudoers does not allow it — re-run: auckland-vpn setup-sudo"
    fixes=$((fixes + 1))
  fi

  if mkdir -p "$STATE_DIR" 2>/dev/null && chmod 700 "$STATE_DIR" 2>/dev/null \
      && touch "$STATE_DIR/.doctor-write-test" 2>/dev/null; then
    rm -f "$STATE_DIR/.doctor-write-test"
    echo "OK   state dir writable at $STATE_DIR"
  else
    echo "FIX  cannot write to $STATE_DIR — fix with: mkdir -p '$STATE_DIR' && chmod 700 '$STATE_DIR'"
    fixes=$((fixes + 1))
  fi

  if [ -f "$LOG_FILE" ]; then
    last_err="$(last_log_error || true)"
    if [ -n "$last_err" ]; then
      echo "INFO last error in log: $last_err"
      echo "     full log: auckland-vpn log"
    else
      echo "OK   no errors in current log"
    fi
  else
    echo "INFO no log yet ($LOG_FILE) — re-run 'auckland-vpn setup-sudo' if the helper is installed."
  fi

  # Monitor status — informational only, never a FIX: is a monitor process
  # alive (lock holder first, scoped pgrep as fallback), and what state did
  # it last record?
  local mon_pid mon_state
  mon_pid="$(cat "$MONITOR_LOCK_DIR/pid" 2>/dev/null || true)"
  case "$mon_pid" in
    ''|*[!0-9]*)
      mon_pid="$(pgrep -f 'auckland-vpn monitor' 2>/dev/null | head -n 1 || true)"
      ;;
  esac
  if [ -n "$mon_pid" ] && kill -0 "$mon_pid" 2>/dev/null; then
    echo "OK   monitor running (pid $mon_pid)"
  else
    echo "INFO monitor not running — optional:  nohup auckland-vpn monitor &  (see README)"
  fi
  mon_state="$(sed -n 's/^current_state=//p' "$MONITOR_STATE_FILE" 2>/dev/null || true)"
  if [ -n "$mon_state" ]; then
    echo "INFO monitor last recorded state: $mon_state"
  else
    echo "INFO no monitor state recorded yet"
  fi

  if [ "$fixes" -gt 0 ]; then
    echo "$fixes check(s) need fixing (see FIX lines above)."
    return 1
  fi
  echo "All checks passed."
}

# One-shot triage (issue #15): doctor's prerequisite checks, then analysis of
# the CURRENT attempt's log section — failure-class markers per the audit
# table, the login-realm evidence check, and transport/DNS findings.
# Strictly read-only: no connection attempt, no privileged action. Exit 1
# only when there is no log to analyse at all.
cmd_diagnose() {
  local attempt hit
  echo "== auckland-vpn diagnose =="
  cmd_doctor || true   # prerequisite findings must not stop log analysis

  echo "--- current attempt (since the last 'start' banner) ---"
  if [ ! -f "$LOG_FILE" ]; then
    echo "No log file yet ($LOG_FILE). Connect once first:  auckland-vpn start"
    return 1
  fi
  attempt="$(attempt_log)"
  if [ -z "$attempt" ]; then
    echo "(no start banner in the log yet — showing the last 20 lines)"
    tail -n 20 "$LOG_FILE"
    return 0
  fi
  printf '%s\n' "$attempt"

  echo "--- findings ---"
  # Authentication classes are deliberately conservative: FortiGate cannot
  # reliably distinguish wrong-password from wrong-token (audit §1).
  if grep -q 'Server is rejecting the soft token\|Failed to generate OTP tokencode' <<<"$attempt"; then
    echo "AUTH:      token-specific failure — refresh the TOTP secret:  auckland-vpn setup"
  elif grep -q 'Invalid credentials; try again' <<<"$attempt"; then
    echo "AUTH:      \"Invalid credentials\" — password OR token rejected (the server cannot say which). Refresh BOTH together:  auckland-vpn setup"
  else
    echo "AUTH:      no authentication-failure markers in this attempt."
  fi

  # Login realm evidence (audit §1): a successful connect logs this line.
  if grep -q "Got login realm 'client'" <<<"$attempt"; then
    echo "REALM:     ok — \"Got login realm 'client'\" present."
  else
    echo "REALM:     WARNING — \"Got login realm 'client'\" NOT found. If connecting also failed, investigate the realm/URL path before blaming credentials (docs/consults/openconnect-audit.md §1)."
  fi

  # DNS application classes (audit §5).
  if grep -q 'Got split-DNS' <<<"$attempt"; then
    echo "DNS:       server pushed split-DNS that OpenConnect 9.x does NOT implement (known upstream limitation — see README)."
  fi
  if grep -q 'Got IPv4 DNS server' <<<"$attempt"; then
    echo "DNS:       VPN DNS servers were pushed ('Got IPv4 DNS server' lines above)."
  else
    echo "DNS:       no 'Got IPv4 DNS server' lines — the server pushed no DNS servers."
  fi

  # Transport classes (audit §2): DTLS preferred; TLS fallback still works.
  if grep -q 'Established DTLS connection\|DTLS is enabled on port' <<<"$attempt"; then
    echo "TRANSPORT: DTLS established."
  elif grep -q 'PPP over TLS' <<<"$attempt"; then
    echo "TRANSPORT: carrying traffic over PPP/TLS fallback (works; TCP-heavy transfers slower)."
  else
    echo "TRANSPORT: no DTLS/TLS marker in this attempt."
  fi

  hit="$(grep -i 'reconnect' <<<"$attempt" | tail -n 3 || true)"
  if [ -n "$hit" ]; then
    echo "--- reconnect-policy lines (cookie reuse is server-dependent; audit §3) ---"
    printf '%s\n' "$hit"
  fi
  return 0
}

usage() {
  cat <<EOF
auckland-vpn — reliable University of Auckland VPN (FortiNet + TOTP 2FA)

  setup       one-time: store VPN password (Keychain) + TOTP secret
  setup-sudo  one sudo prompt: install root-owned helper + restricted sudoers rule
  start       connect (auto 2FA, auto-reconnect; verifies the tunnel came up;
              needs the privileged helper installed by setup-sudo)
  stop        disconnect
  restart     stop, wait out the old process, then start
  status      Connected as ... (pid, IP) / Connecting... / Not connected.
  monitor     supervise the tunnel and auto-restart it when it dies [--once]
              (only heals tunnels that 'start' marked as wanted)
  log         last 50 log lines ('log -f' follows until Ctrl-C)
  pin         print the current server certificate fingerprint
  doctor      check every prerequisite; prints OK/FIX + exact fix per item
  diagnose    doctor checks + failure-class analysis of the last attempt

Examples:
  auckland-vpn setup
  auckland-vpn start
  auckland-vpn status
  auckland-vpn stop

Running 'auckland-vpn' with no arguments (or an unknown one) shows this help
and exits 2 — it never touches the network.
EOF
}

# ---- Dispatch ---------------------------------------------------------------
# Sourcing this file (tests) defines functions without dispatching.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  # Explicit subcommand required: bare invocation or an unknown word shows
  # usage and exits 2 — never an implicit (network-mutating) start.
  case "${1:-}" in
    setup)       cmd_setup ;;
    setup-sudo)  cmd_setup_sudo ;;
    start)       cmd_start ;;
    stop)        cmd_stop ;;
    restart)     cmd_restart ;;
    status)      cmd_status ;;
    monitor)     shift; cmd_monitor "$@" ;;
    log)         shift; cmd_log "$@" ;;
    pin)         cmd_pin ;;
    doctor)      cmd_doctor ;;
    diagnose)    cmd_diagnose ;;
    -h|--help|help) usage ;;
    *) usage; exit 2 ;;
  esac
fi
