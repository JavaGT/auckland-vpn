#!/usr/bin/env bash
# Observation-only prototype for the reliability state machine.
# It NEVER starts/stops the VPN or invokes sudo. Source this file to test the
# pure classify_state function, or run it with --once / --loop.

set -u

VPN_SERVER=${VPN_SERVER:-vpn.auckland.ac.nz}
PID_FILE=${PID_FILE:-/private/etc/auckland-vpn/vpn.pid}
VPN_HEALTH_IP=${VPN_HEALTH_IP:-}
VPN_HEALTH_HOST=${VPN_HEALTH_HOST:-}
VPN_DNS_SERVER=${VPN_DNS_SERVER:-}
TUNNEL_IP=${TUNNEL_IP:-}
INTERVAL=${INTERVAL:-20}
RECONNECT_GRACE=${RECONNECT_GRACE:-90}
DEGRADED_THRESHOLD=${DEGRADED_THRESHOLD:-2}
DEGRADED_GRACE=${DEGRADED_GRACE:-120}
NETWORK_SETTLE_GRACE=${NETWORK_SETTLE_GRACE:-30}

# In-memory prototype state. Production must persist these fields atomically.
current_state=unknown
bad_since=0
degraded_count=0
restart_attempts=0
next_attempt=0
circuit_until=0
healthy_count=0

valid_vpn_pid() {
  local pid command
  pid=$(cat "$PID_FILE" 2>/dev/null) || pid=
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  command=$(ps -p "$pid" -o command= 2>/dev/null) || return 1
  case "$command" in *openconnect*"$VPN_SERVER"*) printf '%s\n' "$pid" ;; *) return 1 ;; esac
}

tunnel_interface() {
  [ -n "$TUNNEL_IP" ] || return 1
  /sbin/ifconfig -a 2>/dev/null | /usr/bin/awk -v ip="$TUNNEL_IP" '
    /^[[:alnum:]]+:/ { iface=$1; sub(/:$/, "", iface) }
    $1 == "inet" && $2 == ip && iface ~ /^utun[0-9]+$/ { print iface; exit }
  '
}

route_interface() {
  [ -n "$1" ] || return 1
  /sbin/route -n get "$1" 2>/dev/null |
    /usr/bin/awk '$1 == "interface:" { print $2; exit }'
}

expected_answer() {
  # Prototype policy: RFC1918 is accepted. Production should use an exact
  # allow-list for the selected University health record.
  /usr/bin/awk '
    /^10\./ { found=1 }
    /^192\.168\./ { found=1 }
    /^172\.(1[6-9]|2[0-9]|3[01])\./ { found=1 }
    END { exit(found ? 0 : 1) }
  '
}

direct_dns_ok() {
  [ -n "$VPN_DNS_SERVER" ] && [ -n "$VPN_HEALTH_HOST" ] || return 1
  /usr/bin/dig +time=2 +tries=1 +short A \
    @"$VPN_DNS_SERVER" "$VPN_HEALTH_HOST" 2>/dev/null | expected_answer
}

system_dns_ok() {
  [ -n "$VPN_HEALTH_HOST" ] || return 1
  /usr/bin/dscacheutil -q host -a name "$VPN_HEALTH_HOST" 2>/dev/null |
    /usr/bin/awk '$1 == "ip_address:" { print $2 }' | expected_answer
}

# classify_state PROCESS_OK TUNNEL_OK ROUTE_OK DIRECT_DNS_OK SYSTEM_DNS_OK
# Prints a state. This pure function is suitable for shell fixture tests.
classify_state() {
  local process_ok=$1 tunnel_ok=$2 route_ok=$3 direct_ok=$4 system_ok=$5
  [ "$process_ok" -eq 1 ] || { echo dead; return; }
  if [ "$tunnel_ok" -ne 1 ] || [ "$route_ok" -ne 1 ]; then
    echo reconnecting
  elif [ "$direct_ok" -ne 1 ] || [ "$system_ok" -ne 1 ]; then
    echo degraded
  else
    echo healthy
  fi
}

observe_state() {
  local process_ok=0 tunnel_ok=0 route_ok=0 direct_ok=0 system_ok=0
  local pid tunnel_if probe_if

  pid=$(valid_vpn_pid 2>/dev/null) && process_ok=1
  tunnel_if=$(tunnel_interface 2>/dev/null) && [ -n "$tunnel_if" ] && tunnel_ok=1
  probe_if=$(route_interface "$VPN_HEALTH_IP" 2>/dev/null) || probe_if=
  [ -n "$tunnel_if" ] && [ "$probe_if" = "$tunnel_if" ] && route_ok=1
  direct_dns_ok && direct_ok=1
  system_dns_ok && system_ok=1

  if [ -z "$VPN_HEALTH_IP" ] || [ -z "$VPN_HEALTH_HOST" ] ||
     [ -z "$VPN_DNS_SERVER" ] || [ -z "$TUNNEL_IP" ]; then
    echo unknown
    return
  fi

  classify_state "$process_ok" "$tunnel_ok" "$route_ok" "$direct_ok" "$system_ok"
}

backoff_seconds() {
  case "$1" in
    1) echo 0 ;;
    2) echo 30 ;;
    3) echo 60 ;;
    4) echo 120 ;;
    5) echo 300 ;;
    *) echo 600 ;;
  esac
}

reset_healthy() {
  bad_since=0
  degraded_count=0
  restart_attempts=0
  next_attempt=0
  circuit_until=0
  healthy_count=2
}

# state_machine_step OBSERVED_STATE EPOCH_SECONDS
# Emits transition/action records. Recovery actions are intentionally only
# text: this prototype contains no executor and therefore cannot call sudo.
state_machine_step() {
  local observed=$1 now=$2 grace=0 delay

  if [ "$circuit_until" -gt "$now" ]; then
    current_state=circuit_open
    printf 'state=circuit_open retry_at=%s\n' "$circuit_until"
    return
  fi

  case "$observed" in
    healthy)
      healthy_count=$((healthy_count + 1))
      bad_since=0
      degraded_count=0
      if [ "$healthy_count" -lt 2 ]; then
        current_state=verifying
        echo 'state=verifying action=wait healthy_checks=1'
      else
        reset_healthy
        current_state=healthy
        echo 'state=healthy'
      fi
      return
      ;;
    unknown)
      bad_since=0
      degraded_count=0
      current_state=unknown
      echo 'state=unknown action=none'
      return
      ;;
    degraded)
      degraded_count=$((degraded_count + 1))
      grace=$DEGRADED_GRACE
      ;;
    reconnecting)
      degraded_count=0
      grace=$RECONNECT_GRACE
      ;;
    dead)
      degraded_count=0
      grace=$NETWORK_SETTLE_GRACE
      ;;
    *)
      echo "state=unknown action=none reason=invalid_observation" >&2
      return 2
      ;;
  esac
  healthy_count=0

  [ "$bad_since" -ne 0 ] || bad_since=$now
  current_state=$observed

  if [ "$observed" = degraded ] &&
     [ "$degraded_count" -lt "$DEGRADED_THRESHOLD" ]; then
    printf 'state=degraded action=wait dns_failures=%s\n' "$degraded_count"
    return
  fi
  if [ $((now - bad_since)) -lt "$grace" ]; then
    printf 'state=%s action=wait grace_remaining=%s\n' \
      "$observed" "$((grace - (now - bad_since)))"
    return
  fi
  if [ "$next_attempt" -gt "$now" ]; then
    printf 'state=%s action=backoff retry_at=%s\n' "$observed" "$next_attempt"
    return
  fi

  restart_attempts=$((restart_attempts + 1))
  if [ "$restart_attempts" -gt 5 ]; then
    circuit_until=$((now + 3600))
    current_state=circuit_open
    printf 'state=circuit_open action=notify retry_at=%s\n' "$circuit_until"
    return
  fi

  delay=$(backoff_seconds "$restart_attempts")
  next_attempt=$((now + delay))
  bad_since=$now
  printf 'state=%s action=WOULD_RESTART attempt=%s next_delay=%s\n' \
    "$observed" "$restart_attempts" "$delay"
}

main() {
  case "${1:---once}" in
    --once)
      local observed now
      observed=$(observe_state)
      now=$(date +%s)
      printf 'observation=%s ' "$observed"
      state_machine_step "$observed" "$now"
      ;;
    --loop|--dry-run)
      local observed now
      echo "Observation only: no restart will be performed. Ctrl-C to stop." >&2
      while :; do
        observed=$(observe_state)
        now=$(date +%s)
        printf '%s observation=%s ' "$(date '+%Y-%m-%d %H:%M:%S')" "$observed"
        state_machine_step "$observed" "$now"
        sleep "$INTERVAL"
      done
      ;;
    *) echo "usage: $0 [--once|--loop|--dry-run]" >&2; return 2 ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
